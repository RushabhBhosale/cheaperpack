---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import Faq from '../../components/shared/Faq.astro';
import LinkGrid from '../../components/shared/LinkGrid.astro';
import { GUIDES, getGuide, guidePath } from '../../data/guides';
import { getTool, toolPath } from '../../data/tools';
import { abs, breadcrumbLd, faqLd, SITE_NAME } from '../../lib/seo';

export function getStaticPaths() { return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const title = `${guide.title} | CheaperPack`;
const description = guide.short;
const asSteps = (guide.format ?? 'steps') === 'steps';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: guide.title, href: guidePath(guide.slug) }];
const words = [guide.intro, ...guide.steps.map((s) => s.body)].join(' ').split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 200));
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description,
    datePublished: guide.published, dateModified: guide.updated, mainEntityOfPage: abs(guidePath(guide.slug)),
    image: abs('/og.png'),
    author: { '@type': 'Organization', name: SITE_NAME, url: abs('/about/') },
    publisher: { '@id': abs('/#organization') },
    citation: guide.sources.map((s) => s.url),
  },
  breadcrumbLd(crumbs),
  faqLd(guide.faq),
];
if (asSteps) jsonLd.push({ '@context': 'https://schema.org', '@type': 'HowTo', name: guide.title, description, step: guide.steps.map((step, index) => ({ '@type': 'HowToStep', position: index + 1, name: step.title, text: step.body })) });

const relatedGuides = guide.related.map(getGuide).filter((g): g is NonNullable<typeof g> => !!g).map((g) => ({ label: g.title, href: guidePath(g.slug), hint: g.type }));
const toolLinks = (guide.tools ?? []).map((slug) => getTool(slug)).map((t) => ({ label: t.name, href: toolPath(t.slug), hint: t.short }));
---
<Base title={title} description={description} jsonLd={jsonLd} type="article" published={guide.published} modified={guide.updated}>
  <article class="page guide-page">
    <Breadcrumbs crumbs={[{ name: 'Guides', href: '/guides/' }, { name: guide.type, href: '/guides/' }]} />
    <header class="guide-hero"><h1>{guide.title}</h1><p class="guide-meta">{guide.type} · reviewed <time datetime={guide.updated}>{guide.updated}</time> · {minutes} min read</p><p class="ownership-lede">{guide.intro}</p></header>
    <ol class:list={['guide-steps', { 'guide-sections': !asSteps }]}>{guide.steps.map((step) => <li><h2>{step.title}</h2><p>{step.body}</p></li>)}</ol>
    <aside class="guide-note"><strong>Keep in mind</strong><p>{guide.note}</p></aside>

    <div class="max-w-[44rem]"><Faq items={guide.faq} heading="Quick answers" /></div>

    <LinkGrid heading="Related guides" links={relatedGuides} id="related-guides" />
    <LinkGrid heading="Useful tools" links={toolLinks} id="tools" />
    <LinkGrid heading="Look up your device" links={guide.links ?? []} id="devices" />

    <section class="source-list"><h2>Sources</h2><ul>{guide.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}</ul><p>Reviewed by the CheaperPack editors. <a href="/about/">How we check our facts</a>.</p></section>
  </article>
</Base>
