---
import Base from '../layouts/Base.astro';
import { FAQ } from '../data/faq';

const title = 'Frequently asked questions | CheaperPack';
const description =
  'Answers about unit prices, comparing different pack sizes and units, multipacks, currencies, rounding and privacy on CheaperPack.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="page pt-8 sm:pt-12"><div class="prose">
    <h1>Frequently asked questions</h1>
    {
      FAQ.map((item) => (
        <section>
          <h2>{item.question}</h2>
          <p>{item.answer}</p>
        </section>
      ))
    }
    <p><a href="/tools/price-comparison/">Compare prices now</a> or <a href="/tools/">see all tools</a>.</p>
  </div></div>
</Base>

