---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/shared/Breadcrumbs.astro';
import DeviceCard from '../../../components/shared/DeviceCard.astro';
import Faq from '../../../components/shared/Faq.astro';
import LinkGrid from '../../../components/shared/LinkGrid.astro';
import { SERIES, comparePairs, devicePath, devicesInSeries } from '../../../data/devices';
import { breadcrumbLd, faqLd, itemListLd } from '../../../lib/seo';

export function getStaticPaths() {
  return SERIES.map((series) => ({ params: { series: series.slug }, props: { series } }));
}

const { series } = Astro.props;
const models = devicesInSeries(series.slug);
const ports = [...new Set(models.map((d) => d.port))];
const portText = ports.length === 1 ? `${ports[0]}` : ports.join(' and ');
const names = models.map((d) => d.name);
const joined = names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names[0]!;
const faq = [
  {
    question: `Does the ${series.name} use USB-C or Lightning?`,
    answer: ports.length === 1 ? `Every model in the ${series.name} (${joined}) has a ${ports[0]} charging port.` : `The ${series.name} mixes ports: ${models.map((d) => `${d.name} uses ${d.port}`).join('; ')}.`,
  },
  { question: `Which models are in the ${series.name}?`, answer: `${joined}.` },
  {
    question: `Do all ${series.name} models have the same chip?`,
    answer: `No, not always. ${models.map((d) => `${d.name}: ${d.chip}`).join('; ')}.`,
  },
];
const title = `${series.name}: models, charging port and specs | CheaperPack`;
const description = `Every model in the ${series.name} compared: ${portText} charging port, chips, display sizes and wireless charging, with links to Apple’s specifications.`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Devices', href: '/devices/' }, { name: series.name, href: `/devices/series/${series.slug}/` }];
const jsonLd = [breadcrumbLd(crumbs), itemListLd(series.name, models.map((d) => ({ name: d.name, href: devicePath(d.slug) }))), faqLd(faq)];

const pairs = comparePairs().filter((p) => p.newer.series === series.slug);
const compareLinks = pairs.map((p) => ({ label: `${p.older.name} vs ${p.newer.name}`, href: `/compare/${p.slug}/` }));
const otherSeries = SERIES.filter((s) => s.slug !== series.slug).map((s) => ({ label: s.name, href: `/devices/series/${s.slug}/`, hint: String(s.year) }));
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="page ownership-intro">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6">{series.name}</h1>
    <p class="ownership-lede">{series.blurb} Charging port: {portText}.</p>
  </section>

  <section class="page series-block" aria-label={`${series.name} models`}>
    <div class="card-grid">{models.map((device) => <DeviceCard device={device} />)}</div>
  </section>

  <section class="page device-copy">
    <h2>{series.name} at a glance</h2>
    <div class="table-wrap">
      <table class="spec-table">
        <thead><tr><th scope="col">Model</th><th scope="col">Display</th><th scope="col">Chip</th><th scope="col">Port</th><th scope="col">Wireless charging</th></tr></thead>
        <tbody>
          {models.map((d) => <tr><th scope="row"><a href={devicePath(d.slug)}>{d.name}</a></th><td>{d.screen}</td><td>{d.chip}</td><td>{d.port}</td><td>{d.wirelessCharging}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>All values are taken from Apple’s technical specifications for each model. Open a model page for the source link.</p>
  </section>

  <div class="page">
    <LinkGrid heading="Compare with the previous generation" links={compareLinks} id="compare" />
    <div class="max-w-[44rem]"><Faq items={faq} heading={`${series.name} questions`} /></div>
    <LinkGrid heading="Other iPhone series" links={otherSeries} id="others" />
  </div>
</Base>
