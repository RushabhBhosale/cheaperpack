---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import Faq from '../../components/shared/Faq.astro';
import LinkGrid from '../../components/shared/LinkGrid.astro';
import { DEVICES, batteryCycleTarget, comparePairs, deviceFaq, devicePath, getSeries, neighbours, siblings } from '../../data/devices';
import { abs, breadcrumbLd, faqLd } from '../../lib/seo';

export function getStaticPaths() {
  return DEVICES.map((device) => ({ params: { slug: device.slug }, props: { device } }));
}

const { device } = Astro.props;
const series = getSeries(device.series)!;
const faq = deviceFaq(device);
const { previous, next } = neighbours(device);
const pairs = comparePairs();
const pairFor = (a?: typeof device, b?: typeof device) => (a && b ? pairs.find((p) => p.older.slug === a.slug && p.newer.slug === b.slug) : undefined);
const compareLinks = [pairFor(previous, device), pairFor(device, next)]
  .filter((p): p is NonNullable<typeof p> => !!p)
  .map((p) => ({ label: `${p.older.name} vs ${p.newer.name}`, href: `/compare/${p.slug}/`, hint: 'What changed between generations' }));

const portLower = device.port === 'USB-C' ? 'usb-c' : 'lightning';
const cycles = batteryCycleTarget(device);
const title = `${device.name}: specs, ${device.port} port, repair help | CheaperPack`;
const description = `${device.name} (${device.year}): ${device.port} charging port, ${device.chip} chip, ${device.screen} display and ${device.wirelessCharging} wireless charging, with Apple source links and cable help.`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Devices', href: '/devices/' }, { name: series.name, href: `/devices/series/${series.slug}/` }, { name: device.name, href: devicePath(device.slug) }];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ProductModel', name: device.name, url: abs(devicePath(device.slug)),
    brand: { '@type': 'Brand', name: 'Apple' }, manufacturer: { '@type': 'Organization', name: 'Apple' },
    category: 'Smartphone', releaseDate: String(device.year), sameAs: device.specsUrl,
    additionalProperty: [
      { '@type': 'PropertyValue', name: 'Charging port', value: device.port },
      { '@type': 'PropertyValue', name: 'Chip', value: device.chip },
      { '@type': 'PropertyValue', name: 'Display', value: device.screen },
      { '@type': 'PropertyValue', name: 'Wireless charging', value: device.wirelessCharging },
    ],
  },
  breadcrumbLd(crumbs),
  faqLd(faq),
];

const guideLinks = [
  { label: 'Charging problems', href: '/guides/iphone-wont-charge/', hint: 'Safe checks before service' },
  { label: 'Battery health', href: '/guides/iphone-battery-health/', hint: 'What the percentage means' },
  { label: 'Buying one used', href: '/guides/buying-a-used-iphone/', hint: 'Activation Lock, parts history, battery' },
  { label: 'Selling or trading in', href: '/guides/sell-or-trade-in-your-iphone/', hint: 'Back up, sign out, erase' },
];
const seriesLinks = siblings(device).map((d) => ({ label: d.name, href: devicePath(d.slug), hint: `${d.screen} · ${d.chip}` }));
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="page device-page">
    <Breadcrumbs crumbs={crumbs} />
    <header class="device-hero">
      <div>
        <h1>{device.name}</h1>
        <p class="device-meta">Apple · introduced {device.year} · <a href={`/devices/series/${series.slug}/`}>{series.name}</a></p>
        <p class="ownership-lede">The {device.name} charges over {device.port}. Here is what to know to keep it working, pick the right cable and check it before you buy or sell.</p>
      </div>
      <div class="device-spec-plate" aria-label={`${device.name} charging connector`}><span>Charging port</span><strong>{device.port}</strong><small>{device.screen} display</small></div>
    </header>

    <section class="device-facts" aria-labelledby="facts-heading">
      <h2 id="facts-heading">{device.name} at a glance</h2>
      <dl>
        <div><dt>Introduced</dt><dd>{device.year}</dd></div>
        <div><dt>Display</dt><dd>{device.screen}</dd></div>
        <div><dt>Chip</dt><dd>{device.chip}</dd></div>
        <div><dt>Charging port</dt><dd>{device.port}</dd></div>
        <div><dt>Wireless charging</dt><dd>{device.wirelessCharging}</dd></div>
        {cycles && <div><dt>Battery design target</dt><dd>80% after {cycles.toLocaleString('en-US')} cycles</dd></div>}
      </dl>
      <a class="source-link" href={device.specsUrl} target="_blank" rel="noreferrer">Check Apple’s full technical specifications ↗</a>
    </section>

    <section class="device-copy">
      <h2>Which cable and charger fit the {device.name}?</h2>
      <p>
        {device.port === 'USB-C'
          ? `The ${device.name} has a USB-C port, so it needs a cable with a USB-C plug at the phone end. Older Lightning cables will not plug in.`
          : `The ${device.name} has a Lightning port, so it needs a cable with a Lightning plug at the phone end, either USB-C to Lightning or USB-A to Lightning. A cable with a USB-C plug at the phone end will not fit.`}
        {' '}This matches the plug only. It does not confirm charging speed, data features or cable quality. See
        <a href={`/ports/${portLower}/`}>every iPhone with {device.port}</a> or use the <a href={`/compatibility/?device=${device.slug}`}>cable compatibility finder</a>.
      </p>
      {cycles && (
        <>
          <h2>{device.name} battery</h2>
          <p>
            Apple designs {device.series === 'iphone-15' ? 'iPhone 15 models' : 'iPhone 14 models and earlier'} to retain up to 80% of original capacity at {cycles.toLocaleString('en-US')} complete charge cycles under normal conditions. Your own phone may differ:
            check Settings → Battery → Battery Health, then read <a href="/guides/iphone-battery-health/">what the number means and when to replace the battery</a>.
          </p>
        </>
      )}
      <h2>Repair, service and buying used</h2>
      <p>Repair options and prices depend on your country and the fault. Start with Apple’s service options, and confirm the exact model before buying parts or accessories because a similar name does not guarantee a fit.</p>
      <ul class="plain-links">
        <li><a href={device.repairUrl} target="_blank" rel="noreferrer">Apple repair and support options ↗</a></li>
        <li><a href="/tools/repair-vs-replace/">Repair vs Replace calculator</a></li>
      </ul>
    </section>

    <section class="device-action-band">
      <div><h2>Before you replace or repair it</h2><p>Match accessories by exact model and connector. For internal repairs, follow the model-specific manual and safety instructions.</p></div>
      <div class="action-links"><a href={`/compatibility/?device=${device.slug}`} class="ownership-button">Check a cable</a><a href="/guides/iphone-wont-charge/">Troubleshoot charging</a></div>
    </section>

    <LinkGrid heading="Compare generations" links={compareLinks} id="compare" />
    <LinkGrid heading={`More in the ${series.name}`} links={seriesLinks} id="series" />
    <LinkGrid heading={`Guides for your ${device.name}`} links={guideLinks} id="guides" />

    <div class="max-w-[44rem]"><Faq items={faq} heading={`${device.name} questions`} /></div>

    <section class="source-list">
      <h2>Sources</h2>
      <ul>
        <li><a href={device.specsUrl} target="_blank" rel="noreferrer">Apple technical specifications for the {device.name} ↗</a></li>
        <li><a href="https://support.apple.com/en-us/108044" target="_blank" rel="noreferrer">Identify your iPhone model — Apple Support ↗</a></li>
        {cycles && <li><a href="https://support.apple.com/en-us/101575" target="_blank" rel="noreferrer">iPhone battery and performance — Apple Support ↗</a></li>}
      </ul>
      <p>Facts reviewed October 2026. <a href="/about/">How we check our facts</a>.</p>
    </section>
  </article>
</Base>
