---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import DeviceCard from '../../components/shared/DeviceCard.astro';
import { DEVICES, SERIES, devicesInSeries } from '../../data/devices';
import { breadcrumbLd, itemListLd } from '../../lib/seo';

const title = `All ${DEVICES.length} iPhone models: specs and charging port | CheaperPack`;
const description = `Search ${DEVICES.length} iPhone models from iPhone 11 to iPhone 17. See each model’s charging port (USB-C or Lightning), chip, display and wireless charging, with Apple source links.`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Devices', href: '/devices/' }];
const jsonLd = [
  breadcrumbLd(crumbs),
  itemListLd('iPhone models', DEVICES.map((d) => ({ name: d.name, href: `/devices/${d.slug}/` }))),
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="page ownership-intro">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6">Find your iPhone.</h1>
    <p class="ownership-lede">Search {DEVICES.length} models for the charging port, chip, display and wireless charging, each linked to Apple’s specifications.</p>
  </section>

  <section class="page device-search" data-ui aria-label="Search and filter iPhones">
    <label for="device-q" class="sr-only">Search iPhone models</label>
    <input id="device-q" type="search" class="search-box" placeholder="Search by model, chip or port, e.g. “iPhone 14 Pro” or “A16”" autocomplete="off" enterkeyhint="search" />
    <div class="chip-row" role="group" aria-label="Filter by charging port">
      <button type="button" class="chip" data-port="" aria-pressed="true">All ports</button>
      <button type="button" class="chip" data-port="USB-C" aria-pressed="false">USB-C</button>
      <button type="button" class="chip" data-port="Lightning" aria-pressed="false">Lightning</button>
    </div>
    <p class="search-count" role="status" aria-live="polite" data-count></p>
  </section>

  <div class="page device-series-list">
    {SERIES.map((series) => (
      <section class="series-block" data-series aria-labelledby={`s-${series.slug}`}>
        <header class="series-head">
          <h2 id={`s-${series.slug}`}><a href={`/devices/series/${series.slug}/`}>{series.name}</a></h2>
          <p>{series.blurb}</p>
        </header>
        <div class="card-grid">
          {devicesInSeries(series.slug).map((device) => <DeviceCard device={device} />)}
        </div>
      </section>
    ))}
    <p class="no-results" data-empty hidden>No iPhone matches that search. Try a model number like “13” or a port like “USB-C”.</p>
  </div>

  <section class="page related-ports">
    <h2>Not sure which cable you need?</h2>
    <p class="data-note">Browse <a href="/ports/usb-c/">every iPhone with USB-C</a> or <a href="/ports/lightning/">every iPhone with Lightning</a>, or <a href="/compare/">compare two models side by side</a>.</p>
    <p class="data-note">Coverage is intentionally limited to models whose key facts we can tie to an Apple source. We add new models as Apple publishes their specifications.</p>
  </section>

  <script>
    const q = document.querySelector<HTMLInputElement>('#device-q')!;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-device-card]')];
    const blocks = [...document.querySelectorAll<HTMLElement>('[data-series]')];
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    let port = '';

    function apply() {
      const terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const hay = card.dataset.search ?? '';
        const ok = terms.every((t) => hay.includes(t)) && (!port || card.dataset.port === port);
        card.hidden = !ok;
        if (ok) shown++;
      }
      for (const block of blocks) block.hidden = !block.querySelector('[data-device-card]:not([hidden])');
      empty.hidden = shown > 0;
      count.textContent = terms.length || port ? `${shown} of ${cards.length} models` : '';
    }

    q.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        port = chip.dataset.port ?? '';
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        apply();
      });
    }
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) q.value = initial;
    apply();
  </script>
</Base>
