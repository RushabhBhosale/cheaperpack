---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import Faq from '../../components/shared/Faq.astro';
import LinkGrid from '../../components/shared/LinkGrid.astro';
import { comparePairs, devicePath } from '../../data/devices';
import { breadcrumbLd, faqLd } from '../../lib/seo';

export function getStaticPaths() {
  return comparePairs().map((pair) => ({ params: { pair: pair.slug }, props: { pair } }));
}

const { older, newer } = Astro.props.pair;
const rows = [
  ['Introduced', String(older.year), String(newer.year)],
  ['Display', older.screen, newer.screen],
  ['Chip', older.chip, newer.chip],
  ['Charging port', older.port, newer.port],
  ['Wireless charging', older.wirelessCharging, newer.wirelessCharging],
] as const;

const changed: string[] = [];
const same: string[] = [];
const note = (label: string, a: string, b: string, text: (a: string, b: string) => string) => (a === b ? same.push(`${label}: ${a}`) : changed.push(text(a, b)));
note('Charging port', older.port, newer.port, (a, b) => `The charging port changes from ${a} to ${b}.`);
note('Chip', older.chip, newer.chip, (a, b) => `The chip changes from ${a} to ${b}.`);
note('Display', older.screen, newer.screen, (a, b) => `The display changes from ${a} to ${b}.`);
note('Wireless charging', older.wirelessCharging, newer.wirelessCharging, (a, b) => `Wireless charging changes from ${a} to ${b}.`);

const portChanged = older.port !== newer.port;
const cableText = portChanged
  ? `Cables do not carry over: the ${older.name} uses ${older.port} and the ${newer.name} uses ${newer.port}. Plan for new cables if you move between them.`
  : `Both phones use ${older.port}, so cables with the right phone-end plug work with either. Cases and screen protectors are still model-specific, so do not assume they carry over.`;

const faq = [
  { question: `Is the ${newer.name} different from the ${older.name}?`, answer: changed.length ? changed.join(' ') : `Apple’s specifications show the same chip, display, port and wireless charging, so the differences are outside the facts we compare.` },
  { question: `Does the ${newer.name} use the same charger as the ${older.name}?`, answer: portChanged ? `No. The ${older.name} uses ${older.port} and the ${newer.name} uses ${newer.port}.` : `They use the same ${older.port} port, so a cable with that plug fits both.` },
];
const title = `${older.name} vs ${newer.name}: what changed? | CheaperPack`;
const description = `${older.name} vs ${newer.name} side by side: charging port (${older.port} vs ${newer.port}), chip, display and wireless charging, with Apple source links.`;
const path = `/compare/${Astro.props.pair.slug}/`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Compare', href: '/compare/' }, { name: `${older.name} vs ${newer.name}`, href: path }];
const jsonLd = [breadcrumbLd(crumbs), faqLd(faq)];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="page device-page">
    <Breadcrumbs crumbs={crumbs} />
    <header class="guide-hero">
      <h1>{older.name} vs {newer.name}</h1>
      <p class="ownership-lede">{changed.length ? changed.join(' ') : 'Apple lists the same chip, display, port and wireless charging for both.'}</p>
    </header>

    <div class="table-wrap">
      <table class="spec-table">
        <thead><tr><th scope="col">Spec</th><th scope="col"><a href={devicePath(older.slug)}>{older.name}</a></th><th scope="col"><a href={devicePath(newer.slug)}>{newer.name}</a></th></tr></thead>
        <tbody>{rows.map(([label, a, b]) => <tr><th scope="row">{label}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
      </table>
    </div>

    <section class="device-copy">
      <h2>What carries over</h2>
      <p>{cableText}</p>
      {same.length > 0 && <p>Unchanged on paper: {same.join('; ')}.</p>}
      <h2>Before you upgrade</h2>
      <p>Specifications are only part of the decision. Check the battery health of the phone you have, the price of repairing it, and what you could sell it for. The <a href="/tools/repair-vs-replace/">Repair vs Replace calculator</a> compares them by cost per month.</p>
    </section>

    <div class="max-w-[44rem]"><Faq items={faq} heading="Common questions" /></div>
    <LinkGrid heading="Related" links={[
      { label: older.name, href: devicePath(older.slug), hint: 'Specs, cable and battery' },
      { label: newer.name, href: devicePath(newer.slug), hint: 'Specs, cable and battery' },
      { label: 'Repair or replace your phone', href: '/guides/repair-or-replace-your-phone/', hint: 'Decision guide' },
      { label: 'Compare any two iPhones', href: '/compare/', hint: 'Pick your own pair' },
    ]} id="related" />
    <section class="source-list">
      <h2>Sources</h2>
      <ul>
        <li><a href={older.specsUrl} target="_blank" rel="noreferrer">Apple technical specifications: {older.name} ↗</a></li>
        <li><a href={newer.specsUrl} target="_blank" rel="noreferrer">Apple technical specifications: {newer.name} ↗</a></li>
      </ul>
    </section>
  </article>
</Base>
