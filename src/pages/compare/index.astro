---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import LinkGrid from '../../components/shared/LinkGrid.astro';
import { DEVICES, SERIES, comparePairs } from '../../data/devices';
import { breadcrumbLd } from '../../lib/seo';

const title = 'Compare iPhones side by side: ports, chips and displays | CheaperPack';
const description = 'Pick any two iPhones from iPhone 11 to iPhone 17 and compare charging port, chip, display and wireless charging, or open a ready-made generation comparison.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Compare', href: '/compare/' }];
const jsonLd = [
  breadcrumbLd(crumbs),
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'iPhone comparison tool', url: 'https://cheaperpack.com/compare/', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
];
const pairs = comparePairs().reverse().map((p) => ({ label: `${p.older.name} vs ${p.newer.name}`, href: `/compare/${p.slug}/` }));
const data = DEVICES.map(({ slug, name, year, screen, chip, port, wirelessCharging }) => ({ slug, name, year, screen, chip, port, wirelessCharging }));
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="page ownership-intro">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6">Compare two iPhones.</h1>
    <p class="ownership-lede">See what actually differs: the charging port, chip, display and wireless charging, from Apple’s specifications.</p>
  </section>

  <section class="page finder-shell compare-shell" data-ui>
    <form class="finder-form">
      <label for="cmp-a">First iPhone</label>
      <select id="cmp-a">{SERIES.map((s) => <optgroup label={s.name}>{DEVICES.filter((d) => d.series === s.slug).map((d) => <option value={d.slug}>{d.name}</option>)}</optgroup>)}</select>
      <label for="cmp-b">Second iPhone</label>
      <select id="cmp-b">{SERIES.map((s) => <optgroup label={s.name}>{DEVICES.filter((d) => d.series === s.slug).map((d) => <option value={d.slug}>{d.name}</option>)}</optgroup>)}</select>
    </form>
    <div class="finder-result compare-result" id="cmp-result" aria-live="polite"></div>
  </section>

  <div class="page">
    <LinkGrid heading="Ready-made generation comparisons" links={pairs} id="pairs" />
  </div>

  <script type="application/json" id="cmp-data" set:html={JSON.stringify(data)}></script>
  <script>
    type D = { slug: string; name: string; year: number; screen: string; chip: string; port: string; wirelessCharging: string };
    const data = JSON.parse(document.querySelector('#cmp-data')!.textContent!) as D[];
    const a = document.querySelector<HTMLSelectElement>('#cmp-a')!;
    const b = document.querySelector<HTMLSelectElement>('#cmp-b')!;
    const out = document.querySelector<HTMLElement>('#cmp-result')!;
    const params = new URLSearchParams(location.search);
    a.value = data.some((d) => d.slug === params.get('a')) ? params.get('a')! : 'iphone-14';
    b.value = data.some((d) => d.slug === params.get('b')) ? params.get('b')! : 'iphone-15';

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    function render() {
      const x = data.find((d) => d.slug === a.value)!;
      const y = data.find((d) => d.slug === b.value)!;
      const rows: [string, string, string][] = [
        ['Introduced', String(x.year), String(y.year)],
        ['Display', x.screen, y.screen],
        ['Chip', x.chip, y.chip],
        ['Charging port', x.port, y.port],
        ['Wireless charging', x.wirelessCharging, y.wirelessCharging],
      ];
      const verdict = x.slug === y.slug
        ? 'Pick two different models to compare.'
        : x.port === y.port ? `Both use ${x.port}, so the same cable plug fits either.` : `Different ports: ${x.name} uses ${x.port}, ${y.name} uses ${y.port}. Cables do not carry over.`;
      out.innerHTML = `<div><h2>${esc(verdict)}</h2><div class="table-wrap"><table class="spec-table"><thead><tr><th scope="col">Spec</th><th scope="col"><a href="/devices/${x.slug}/">${esc(x.name)}</a></th><th scope="col"><a href="/devices/${y.slug}/">${esc(y.name)}</a></th></tr></thead><tbody>${rows.map(([l, p, q]) => `<tr><th scope="row">${l}</th><td>${esc(p)}</td><td>${esc(q)}</td></tr>`).join('')}</tbody></table></div></div>`;
      const next = new URLSearchParams({ a: a.value, b: b.value });
      history.replaceState(null, '', `${location.pathname}?${next}`);
    }
    a.addEventListener('change', render);
    b.addEventListener('change', render);
    render();
  </script>
</Base>
