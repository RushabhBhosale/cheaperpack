---
import Base from '../layouts/Base.astro';
import { DEVICES, SERIES } from '../data/devices';
import { breadcrumbLd } from '../lib/seo';

const title = 'iPhone cable compatibility finder: USB-C or Lightning? | CheaperPack';
const description = 'Pick your iPhone (11 to 17) and a cable type to see if the plug fits. Based on the charging port in Apple’s specifications. Free, no sign-up.';
const productTypes = [
  { id: 'usb-c-usb-c', name: 'USB-C to USB-C cable', phoneEnd: 'USB-C', explanation: 'A USB-C plug at the phone end.' },
  { id: 'usb-c-lightning', name: 'USB-C to Lightning cable', phoneEnd: 'Lightning', explanation: 'A Lightning plug at the phone end.' },
  { id: 'usb-a-lightning', name: 'USB-A to Lightning cable', phoneEnd: 'Lightning', explanation: 'A Lightning plug at the phone end.' },
];
---
<Base title={title} description={description} jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'CheaperPack Cable Compatibility Finder', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: 'https://cheaperpack.com/compatibility/' }, breadcrumbLd([{ name: 'Home', href: '/' }, { name: 'Cable finder', href: '/compatibility/' }])]}>
  <section class="page ownership-intro compatibility-intro">
    <h1>Will this cable plug in?</h1>
    <p class="ownership-lede">Choose the exact phone model and the cable connector at the phone end. Results cover the physical plug fit only. Or see <a href="/ports/usb-c/">every iPhone with USB-C</a> and <a href="/ports/lightning/">every iPhone with Lightning</a>.</p>
  </section>
  <section class="page finder-shell" data-ui>
    <form id="compatibility-form" class="finder-form">
      <label for="device-select">Your phone</label>
      <select id="device-select" name="device" required>
        <option value="">Choose a model</option>
        {SERIES.map((s) => <optgroup label={s.name}>{DEVICES.filter((d) => d.series === s.slug).map((device) => <option value={device.slug}>{device.name}</option>)}</optgroup>)}
        <option value="unknown">I’m not sure</option>
      </select>
      <label for="cable-select">Cable type</label>
      <select id="cable-select" name="cable" required>
        {productTypes.map((type) => <option value={type.id}>{type.name}</option>)}
      </select>
      <button class="ownership-button" type="submit">Check fit</button>
    </form>
    <div id="compatibility-result" class="finder-result" aria-live="polite" aria-atomic="true">
      <span class="result-mark" aria-hidden="true">?</span><div><h2>Select a phone and cable</h2><p>The result will cite the manufacturer facts used for the connector match.</p></div>
    </div>
  </section>
  <section class="page finder-limits">
    <h2>What this check covers</h2>
    <p>It matches the cable’s phone-end connector to the port listed in Apple’s specifications. It does not verify charging speed, data features, adapter quality, cable condition or third-party certification.</p>
    <p>A connector match cannot confirm model-specific fit for cases, screen protectors, batteries or internal parts. This finder leaves those checks unanswered until fit data is verified.</p>
  </section>
  <script type="application/json" id="compatibility-data" set:html={JSON.stringify({ devices: DEVICES, productTypes })}></script>
  <script>
    type DeviceOption = { slug: string; name: string; port: string; specsUrl: string };
    type CableOption = { id: string; name: string; phoneEnd: string; explanation: string };
    const rawData = document.querySelector<HTMLScriptElement>('#compatibility-data')?.textContent ?? '{}';
    const { devices = [], productTypes = [] } = JSON.parse(rawData) as { devices: DeviceOption[]; productTypes: CableOption[] };
    const form = document.querySelector<HTMLFormElement>('#compatibility-form');
    const deviceSelect = document.querySelector<HTMLSelectElement>('#device-select');
    const cableSelect = document.querySelector<HTMLSelectElement>('#cable-select');
    const result = document.querySelector<HTMLDivElement>('#compatibility-result');
    if (!form || !deviceSelect || !cableSelect || !result) throw new Error('Compatibility finder markup is incomplete.');
    const deviceFromUrl = new URLSearchParams(location.search).get('device');
    if (deviceFromUrl && devices.some((device) => device.slug === deviceFromUrl)) deviceSelect.value = deviceFromUrl;
    const showResult = () => {
      const device = devices.find((item) => item.slug === deviceSelect.value);
      const cable = productTypes.find((item) => item.id === cableSelect.value);
      if (!cable) return;
      if (!device) {
        result.innerHTML = '<span class="result-mark result-unknown" aria-hidden="true">?</span><div><h2>Check the exact model first</h2><p>Open Settings → General → About to confirm the model, then compare the port on Apple’s specifications page.</p><a href="/devices/">Browse verified device pages ↗</a></div>';
        return;
      }
      const matches = device.port === cable.phoneEnd;
      const status = matches ? 'Connector matches' : 'Connector does not match';
      const tone = matches ? 'result-match' : 'result-no-match';
      const explanation = matches ? `${cable.explanation} ${device.name} has a ${device.port} charging port.` : `${cable.explanation} ${device.name} has a ${device.port} charging port, so the plug will not fit directly.`;
      result.innerHTML = `<span class="result-mark ${tone}" aria-hidden="true">${matches ? 'YES' : 'NO'}</span><div><h2>${status}</h2><p>${explanation}</p><a href="${device.specsUrl}" target="_blank" rel="noreferrer">Apple ${device.name} technical specifications ↗</a></div>`;
    };
    form.addEventListener('submit', (event) => { event.preventDefault(); showResult(); });
    deviceSelect.addEventListener('change', showResult);
    cableSelect.addEventListener('change', showResult);
    if (deviceSelect.value) showResult();
  </script>
</Base>
