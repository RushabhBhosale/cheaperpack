---
import Base from '../layouts/Base.astro';
import DeviceCard from '../components/shared/DeviceCard.astro';
import { DEVICES, SERIES, getDevice } from '../data/devices';
import { GUIDES, guidePath } from '../data/guides';
import { TOOLS, toolPath } from '../data/tools';
import { websiteLd, itemListLd } from '../lib/seo';

const title = 'CheaperPack: Make Your Tech Last Longer | iPhone Guides & Specs';
const description = 'Source-linked iPhone guides: fix charging and battery problems, find the right cable (USB-C or Lightning), compare models and buy or sell used phones with confidence.';
const popular = ['iphone-15', 'iphone-14', 'iphone-13', 'iphone-12', 'iphone-16-pro', 'iphone-11', 'iphone-se-3rd-generation', 'iphone-17']
  .map((slug) => getDevice(slug)!);
const featured = ['iphone-wont-charge', 'iphone-battery-health', 'buying-a-used-iphone', 'repair-or-replace-your-phone', 'iphone-overheating', 'lightning-vs-usb-c-iphone']
  .map((slug) => GUIDES.find((g) => g.slug === slug)!);
const jsonLd = [websiteLd, itemListLd('Popular iPhone guides', popular.map((d) => ({ name: d.name, href: `/devices/${d.slug}/` })))];
const tech = TOOLS.filter((t) => t.category === 'Tech' || ['cost-per-use', 'emi-vs-cash', 'electricity-cost'].includes(t.slug));
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="page ownership-home-hero">
    <div class="home-copy">
      <h1 data-reveal>Make your tech last longer.</h1>
      <p class="ownership-lede" data-reveal>Fix what you can, pick the right cable and buy or sell a used phone with fewer surprises. Every fact links to its source.</p>
      <form class="hero-search" action="/devices/" method="get" role="search" data-reveal>
        <label for="hero-q" class="sr-only">Search iPhone models</label>
        <input id="hero-q" name="q" type="search" class="search-box" placeholder="Search your iPhone, e.g. iPhone 14 Pro" autocomplete="off" enterkeyhint="search" />
        <button type="submit" class="ownership-button">Search</button>
      </form>
      <div class="home-actions"><a class="quiet-link" href="/compatibility/">Check cable compatibility <span aria-hidden="true">↗</span></a><a class="quiet-link" href="/compare/">Compare two iPhones <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="home-finder" data-ui>
      <h2 data-reveal>Which port does it have?</h2>
      <p data-reveal>iPhone 15 and later use USB-C. Earlier models use Lightning.</p>
      <form action="/compatibility/" method="get">
        <label for="home-device">Choose an iPhone</label>
        <select id="home-device" name="device" required>
          <option value="">Select model</option>
          {SERIES.map((s) => <optgroup label={s.name}>{DEVICES.filter((d) => d.series === s.slug).map((device) => <option value={device.slug}>{device.name} · {device.port}</option>)}</optgroup>)}
          <option value="unknown">I’m not sure</option>
        </select>
        <button type="submit">Check a cable <span aria-hidden="true">→</span></button>
      </form>
      <small>Connector fit only · manufacturer sources</small>
    </div>
  </section>

  <section class="ownership-band">
    <div class="page ownership-band-inner">
      <h2 data-reveal>Fix. Fit. Choose.</h2>
      <p data-reveal>Try the safe checks before paying for a repair. Know what fits before you order. Inspect a used phone before money changes hands.</p>
    </div>
  </section>

  <section class="page home-paths">
    <header class="section-heading"><div><h2 data-reveal>Start with the problem.</h2></div><a class="quiet-link" data-reveal href="/guides/">All guides <span aria-hidden="true">↗</span></a></header>
    <div class="card-grid guide-cards">
      {featured.map((g) => <a class="guide-card" data-reveal href={guidePath(g.slug)}><small>{g.type}</small><strong>{g.title}</strong><span>{g.short}</span></a>)}
    </div>
  </section>

  <section class="home-devices">
    <div class="page">
      <header class="section-heading"><div><h2 data-reveal>Popular iPhones.</h2></div><a class="quiet-link" data-reveal href="/devices/">All {DEVICES.length} models <span aria-hidden="true">↗</span></a></header>
      <div class="card-grid">{popular.map((device) => <DeviceCard device={device} />)}</div>
      <p class="data-note home-ports">Browse by port: <a href="/ports/usb-c/">iPhones with USB-C</a> · <a href="/ports/lightning/">iPhones with Lightning</a></p>
    </div>
  </section>

  <section class="page home-tools">
    <div><h2 data-reveal>Tools that settle the decision.</h2><p data-reveal>Is a repair worth it? What does a phone really cost per month? Do the sums in your browser, privately.</p></div>
    <ul class="link-grid home-tool-links">
      {tech.map((t) => <li><a href={toolPath(t.slug)}><strong>{t.name}</strong><small>{t.short}</small></a></li>)}
      <li><a href="/tools/"><strong>All tools</strong><small>Prices, deals, subscriptions and more</small></a></li>
    </ul>
  </section>

  <section class="page home-trust">
    <h2>How we keep it reliable</h2>
    <p>Device facts come from Apple’s technical specifications and each page links to them. Guides summarise manufacturer support articles and name them. If we cannot verify something, we leave it out. <a href="/about/">Read how we check our facts</a>.</p>
  </section>
</Base>
