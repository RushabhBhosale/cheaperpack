---
import ToolLayout from '../../components/layout/ToolLayout.astro';
import ResultPanel from '../../components/shared/ResultPanel.astro';
import ExampleNote from '../../components/shared/ExampleNote.astro';
import UseRow from '../../components/tools/UseRow.astro';
import { compareCostPerUse } from '../../lib/calculations/cost-per-use';

const faq = [
  {
    question: 'What is cost per use?',
    answer:
      'The total cost of owning something divided by the number of times you use it. A ₹5,000 pair of shoes worn 400 times costs less per wear than a ₹2,000 pair worn 100 times.',
  },
  {
    question: 'What should I count as upkeep?',
    answer: 'Anything you’ll spend to keep using it: repairs, servicing, cleaning, refills, cartridges or subscriptions it needs.',
  },
  {
    question: 'How do I estimate the number of uses?',
    answer: 'Multiply how often you’ll use it by how long it should last. Twice a week for two years is about 200 uses. Be honest: the estimate matters more than anything else here.',
  },
];
const ex = compareCostPerUse([
  { price: 2000, uses: 100, maintenance: 0, resale: 0 },
  { price: 5000, uses: 400, maintenance: 0, resale: 0 },
]);
---

<ToolLayout slug="cost-per-use" intro="Work out what you really pay each time you use something, and compare options." faq={faq}>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start lg:gap-10">
    <div data-tool>
      <ExampleNote />
      <ol class="grid gap-3" data-rows aria-label="Options to compare">
        <UseRow values={{ name: 'Shoes A', price: '2000', uses: '100' }} />
        <UseRow values={{ name: 'Shoes B', price: '5000', uses: '400' }} />
      </ol>
      <template data-row-template><UseRow /></template>
      <button type="button" class="btn btn-link mt-3" data-add>+ Add option</button>
    </div>
    <ResultPanel empty="Enter a price and how many times you’ll use it." />
  </div>

  <Fragment slot="content">
    <h2>Why cost per use matters</h2>
    <p>
      The cheaper thing to buy isn’t always the cheaper thing to own. Something that lasts longer, or that you use more, can cost
      less each time even with a higher price tag.
    </p>
    <h2>Example</h2>
    <p>
      Shoes A cost ₹2,000 and you’d wear them 100 times: ₹{ex.results[0]!.perUse} per wear. Shoes B cost ₹5,000 and last 400 wears:
      ₹{ex.results[1]!.perUse} per wear. Shoes B are {(ex.cheaperBy * 100).toFixed(1)}% cheaper each time you wear them.
    </p>
  </Fragment>
</ToolLayout>

<script>
  import '../../scripts/tools/cost-per-use';
</script>
