---
import ToolLayout from '../../components/layout/ToolLayout.astro';
import ResultPanel from '../../components/shared/ResultPanel.astro';
import ExampleNote from '../../components/shared/ExampleNote.astro';
import Field from '../../components/shared/Field.astro';
import { calculateEmi } from '../../lib/calculations/emi';
import { encodeStateForBuild } from '../../lib/ui/share-build';

const faq = [
  {
    question: 'Is no-cost EMI really free?',
    answer:
      'Not always. Usually the bank still charges interest, and the shop gives you a discount equal to that interest. You may still pay a processing fee and tax on the interest, and you may lose a discount for paying upfront. Enter those amounts to see the real difference.',
  },
  {
    question: 'How is the EMI calculated?',
    answer:
      'On a reducing balance: each month’s interest is charged on what you still owe, so the interest part shrinks and the repayment part grows. The formula is EMI = P × r × (1 + r)^n ÷ ((1 + r)^n − 1), where r is the monthly rate and n the number of months.',
  },
  {
    question: 'What is the effective yearly rate?',
    answer:
      'It’s the interest rate that would make the instalments and upfront fees equal to the cash price today. It includes fees and lost discounts, so it shows what borrowing really costs, even for offers advertised as interest-free.',
  },
  {
    question: 'Are the results exact?',
    answer:
      'They’re estimates. Lenders may round instalments, charge tax on interest and fees (for example GST in India), or count days differently. Check the final terms before you sign.',
  },
];

const ex = calculateEmi({ price: 60000, downPayment: 0, annualRate: 0, months: 6, processingFee: 199, otherCharges: 0, cashDiscount: 3000, noCostDiscount: 0 });
const exampleLink = `#${encodeStateForBuild({ price: '60000', down: '', rate: '0', months: '6', fee: '199', other: '', cash: '3000', nocost: '' })}`;
---

<ToolLayout slug="emi-vs-cash" intro="See what paying in instalments really costs compared with paying the full price today." faq={faq}>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start lg:gap-10">
    <div data-tool class="grid grid-cols-1 gap-4">
      <ExampleNote />
      <div class="grid grid-cols-2 gap-3 rounded-card border border-line p-4 sm:p-5">
        <Field label="Product price" k="price" prefix="currency" value="60000" class="col-span-2" />
        <Field label="Interest rate" k="rate" suffix="% a year" value="14" hint="0 for an interest-free plan" />
        <Field label="Duration" k="months" suffix="months" value="12" />
        <Field label="Down payment" k="down" prefix="currency" optional />
        <Field label="Processing fee" k="fee" prefix="currency" optional />
      </div>
      <details class="group rounded-card border border-line p-4 sm:p-5" open>
        <summary class="flex list-none items-center justify-between text-[15px] font-semibold [&::-webkit-details-marker]:hidden">
          Discounts and other charges <span class="text-muted transition group-open:rotate-180" aria-hidden="true">⌄</span>
        </summary>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <Field label="Discount for paying upfront" k="cash" prefix="currency" optional hint="Only if you pay in full today" />
          <Field label="No-cost EMI discount" k="nocost" prefix="currency" optional hint="Discount that offsets the interest" />
          <Field label="Other charges" k="other" prefix="currency" optional hint="e.g. tax on interest, insurance" class="col-span-2" />
        </div>
      </details>
    </div>
    <ResultPanel empty="Enter the price, rate and duration to compare EMI with paying upfront." />
  </div>

  <Fragment slot="content">
    <h2>EMI or pay upfront?</h2>
    <p>
      Paying in instalments spreads the cost, but you usually pay more in total: interest, processing fees and sometimes a lost
      discount for paying in full. This calculator adds all of that up so you can compare like with like.
    </p>
    <h2>Example: a “no-cost” EMI that isn’t free</h2>
    <p>
      A ₹60,000 phone on a 6-month interest-free plan with a ₹199 processing fee, while paying upfront gets you ₹3,000 off. The
      instalments total ₹60,000 plus the fee, ₹{ex.emiTotal.toLocaleString('en-IN')} in all. Paying upfront costs ₹{ex.cashTotal.toLocaleString('en-IN')}, so the EMI costs
      ₹{ex.extraVsCash.toLocaleString('en-IN')} more, roughly {ex.effectiveAnnualRate?.toFixed(0)}% a year in effect. <a href={exampleLink}>Open this example</a>.
    </p>
    <p><em>Results are estimates for comparison, not a loan offer. Check the lender’s final terms.</em></p>
  </Fragment>
</ToolLayout>

<script>
  import '../../scripts/tools/emi';
</script>
