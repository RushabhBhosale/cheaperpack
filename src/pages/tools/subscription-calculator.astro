---
import ToolLayout from '../../components/layout/ToolLayout.astro';
import Field from '../../components/shared/Field.astro';
import SelectField from '../../components/shared/SelectField.astro';
import CurrencySelect from '../../components/shared/CurrencySelect.astro';
import { compareAnnualPlan } from '../../lib/calculations/subscriptions';

const categories = ['Entertainment', 'Music', 'Software', 'Cloud storage', 'News & reading', 'Fitness', 'Food & delivery', 'Shopping', 'Phone & internet', 'Other'];
const faq = [
  {
    question: 'Is my subscription list stored anywhere?',
    answer:
      'Only in this browser, on this device. Nothing is sent to a server and the list can’t be shared by link. “Delete all” removes it.',
  },
  {
    question: 'How are different billing cycles compared?',
    answer:
      'Everything is converted to a monthly equivalent: a yearly plan is divided by 12, a quarterly plan by 3, and a weekly plan is multiplied by 52 and divided by 12.',
  },
  {
    question: 'Is an annual plan worth it?',
    answer:
      'If you’ll keep the service for the whole year, usually yes. Enter the monthly and annual prices below the list to see the saving and how many months the annual price is worth.',
  },
];
const plan = compareAnnualPlan(199, 1499);
---

<ToolLayout slug="subscription-calculator" intro="List your subscriptions to see what they really cost and what you could save." faq={faq}>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start lg:gap-10">
    <div class="grid grid-cols-1 gap-4">
      <form class="rounded-card border border-line p-4 sm:p-5" data-sub-form novalidate>
        <h2 class="text-[16px] font-semibold" data-form-title>Add a subscription</h2>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <Field label="Name" k="name" type="text" placeholder="e.g. Netflix" class="col-span-2" />
          <Field label="Amount" k="amount" prefix="currency" placeholder="0" />
          <SelectField
            label="Billed"
            k="cycle"
            value="monthly"
            options={[
              { value: 'monthly', label: 'Monthly' },
              { value: 'quarterly', label: 'Every 3 months' },
              { value: 'yearly', label: 'Yearly' },
              { value: 'weekly', label: 'Weekly' },
            ]}
          />
          <SelectField label="Category" k="category" value="Entertainment" options={categories.map((c) => ({ value: c, label: c }))} />
          <Field label="Next renewal" k="renewal" type="date" optional />
        </div>
        <div class="mt-4 flex gap-2">
          <button type="submit" class="btn btn-primary" data-submit>Add subscription</button>
          <button type="button" class="btn btn-ghost" data-cancel-edit hidden>Cancel</button>
        </div>
      </form>

      <section aria-labelledby="subs-title">
        <div class="flex items-center justify-between px-1">
          <h2 id="subs-title" class="eyebrow">Your subscriptions</h2>
          <button type="button" class="btn btn-ghost !min-h-9 !px-2 !text-[13px]" data-clear hidden>Delete all</button>
        </div>
        <ul class="mt-2 divide-y divide-line rounded-card border border-line" data-list></ul>
        <p class="mt-2 rounded-card border border-dashed border-line p-5 text-center text-[15px] text-muted" data-list-empty>
          No subscriptions yet. Add your first one above. They’re saved on this device only.
        </p>
      </section>

      <section class="rounded-card border border-line p-4 sm:p-5" aria-labelledby="plan-title" data-plan>
        <h2 id="plan-title" class="text-[16px] font-semibold">Monthly or annual plan?</h2>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <Field label="Monthly price" k="pm" prefix="currency" placeholder="e.g. 199" />
          <Field label="Annual price" k="pa" prefix="currency" placeholder="e.g. 1499" />
        </div>
        <p class="mt-3 text-[15px] text-ink-2" data-plan-result role="status" aria-live="polite">Enter both prices to compare.</p>
      </section>
    </div>

    <div class="lg:sticky lg:top-20">
      <section class="result-panel" aria-labelledby="sum-title">
        <div class="flex items-center justify-between gap-3">
          <h2 id="sum-title" class="eyebrow">Summary</h2>
          <CurrencySelect />
        </div>
        <div data-summary class="mt-3"></div>
      </section>
      <p class="sr-only" role="status" aria-live="polite" data-live></p>
    </div>
  </div>

  <Fragment slot="content">
    <h2>Why add up subscriptions?</h2>
    <p>
      Small monthly charges are easy to forget. Seeing them as one yearly total makes it clear which ones are worth keeping. Tick
      “Consider cancelling” on any you rarely use to see what you’d save.
    </p>
    <h2>Example: monthly vs annual</h2>
    <p>
      A plan costs 199 a month or 1,499 a year. Twelve months on the monthly plan cost {plan.monthlyForYear.toLocaleString('en-IN')}, so the annual
      plan saves {plan.saving} ({(plan.savingFraction * 100).toFixed(0)}%). It pays off if you’d keep the service for more than about{' '}
      {Math.ceil(plan.breakEvenMonths)} months.
    </p>
  </Fragment>
</ToolLayout>

<script>
  import '../../scripts/tools/subscriptions';
</script>
