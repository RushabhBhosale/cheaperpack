---
import ToolLayout from '../../components/layout/ToolLayout.astro';
import PriceTool from '../../components/tool/PriceTool.astro';
import { compareProducts } from '../../lib/calculations/compare';
import { encodeShare, type ToolProduct } from '../../lib/storage/tool-state';
import { TOOL_FAQ } from '../../data/tool-faq';

// Illustrative examples, calculated at build time with the same code as the tool.
const examples: { title: string; note: string; products: ToolProduct[] }[] = [
  {
    title: 'Juice: 250 ml or 500 ml?',
    note: 'The bigger bottle is better value here.',
    products: [
      { name: 'Small bottle', price: '180', quantity: '250', unit: 'ml' },
      { name: 'Large bottle', price: '320', quantity: '500', unit: 'ml' },
    ],
  },
  {
    title: 'Detergent powder: 2 kg or 1.5 kg?',
    note: 'The lower shelf price isn’t the better deal.',
    products: [
      { name: '2 kg pack', price: '210', quantity: '2', unit: 'kg' },
      { name: '1.5 kg pack', price: '189', quantity: '1.5', unit: 'kg' },
    ],
  },
  {
    title: 'Atta: 5 kg or 10 kg?',
    note: 'Bigger isn’t always cheaper: here the smaller bag wins.',
    products: [
      { name: '5 kg bag', price: '245', quantity: '5', unit: 'kg' },
      { name: '10 kg bag', price: '510', quantity: '10', unit: 'kg' },
    ],
  },
  {
    title: 'Eggs: 6 or a tray of 30?',
    note: 'Compared per piece.',
    products: [
      { name: 'Box of 6', price: '42', quantity: '6', unit: 'item' },
      { name: 'Tray of 30', price: '200', quantity: '30', unit: 'item' },
    ],
  },
];

const inr = (v: number) => {
  const whole = Math.abs(v - Math.round(v)) < 0.005;
  return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: whole ? 0 : 2, maximumFractionDigits: whole ? 0 : 2 }).format(v);
};
const worked = examples.map((ex) => {
  const perUnitId = ex.products[0]!.unit === 'item' ? 'item' : ex.products[0]!.unit === 'kg' ? 'kg' : '100ml';
  const r = compareProducts(ex.products, { perUnitId });
  if (r.status !== 'ok' || r.allTied) throw new Error(`Example "${ex.title}" must have a clear winner`);
  const best = r.best[0]!;
  const other = r.runnerUp!;
  const per = r.perUnit.id === 'item' ? 'piece' : r.perUnit.label;
  return {
    ...ex,
    per,
    rows: r.products.map((p) => ({ label: p.label, price: inr(p.price), qty: `${p.quantity} ${p.unit.id === 'item' ? 'pcs' : p.unit.symbol}`, unit: inr(p.unitPrice), best: p.isBest })),
    verdict: `${best.label} is ${((other.unitPrice - best.unitPrice) / other.unitPrice * 100).toFixed(1)}% cheaper per ${per}.`,
    href: `/tools/price-comparison/#${encodeShare({ currency: 'INR', products: ex.products })}`,
  };
});

---

<ToolLayout slug="price-comparison" heading="Which pack is cheaper?" intro="Type, paste or scan prices. See the better buy instantly." faq={TOOL_FAQ}>
  <PriceTool />

  <Fragment slot="content">
    <h2>How to compare prices by quantity</h2>
    <p>
      Packs come in different sizes, so the shelf price alone doesn’t tell you which is better value. The fair way to compare is the{' '}
      <strong>unit price</strong>: what you pay for the same amount, such as per kilogram, per 100 ml or per piece.
    </p>
    <ol>
      <li>Enter each pack’s price and quantity, or type them in one line like “2kg for 210, 1.5kg for 189”.</li>
      <li>CheaperPack converts the quantities to the same unit: grams with kilograms, millilitres with litres, ounces with pounds.</li>
      <li>It divides each price by its quantity and highlights the lowest price for the same amount.</li>
    </ol>
    <p class="formula">price per unit = price ÷ quantity (in the same unit)</p>

    <h2>Shopping examples</h2>
    <p>Illustrative prices to show how it works, not live shop prices.</p>
    {
      worked.map((ex) => (
        <div class="mt-4 rounded-card border border-line p-4">
          <h3 class="!mt-0">{ex.title}</h3>
          {ex.rows.map((row) => (
            <div class:list={['flex justify-between gap-4 py-1 text-[15px]', { 'font-semibold text-good': row.best }]}>
              <span>
                {row.label}: {row.price} for {row.qty}
              </span>
              <span class="num">
                {row.unit} / {ex.per}
                {row.best && ' ✓'}
              </span>
            </div>
          ))}
          <p class="!mb-1">
            {ex.verdict} {ex.note}
          </p>
          <a href={ex.href}>Open this example in the tool</a>
        </div>
      ))
    }

    <h2>Tips for scanning price tags</h2>
    <ul>
      <li>Fill the frame with the label, hold steady and avoid glare from shop lights.</li>
      <li>Shelf labels often show both the pack price and a price per 100 g. CheaperPack uses the pack price.</li>
      <li>Check the details before adding them. Everything the scanner reads can be corrected.</li>
    </ul>
    <p>
      Want the details? See <a href="/how-it-works/">how unit prices are calculated</a>, with exact conversion tables.
    </p>
  </Fragment>
</ToolLayout>
