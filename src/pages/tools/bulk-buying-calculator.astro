---
import ToolLayout from '../../components/layout/ToolLayout.astro';
import ResultPanel from '../../components/shared/ResultPanel.astro';
import ExampleNote from '../../components/shared/ExampleNote.astro';
import Field from '../../components/shared/Field.astro';
import SelectField from '../../components/shared/SelectField.astro';
import UnitSelect from '../../components/shared/UnitSelect.astro';
import { calculateBulk } from '../../lib/calculations/bulk';
import { encodeStateForBuild } from '../../lib/ui/share-build';

const periods = [
  { value: 'day', label: 'a day' },
  { value: 'week', label: 'a week' },
  { value: 'month', label: 'a month' },
];
const lifePeriods = [
  { value: 'day', label: 'days' },
  { value: 'week', label: 'weeks' },
  { value: 'month', label: 'months' },
];

const faq = [
  {
    question: 'What is the break-even amount?',
    answer:
      'It’s how much of the bulk pack you need to actually use for it to cost less than buying that amount in regular packs. If you’d throw away more than the rest, the regular pack is the better buy.',
  },
  {
    question: 'How is waste worked out?',
    answer:
      'If you enter how much you use and how long the pack lasts once opened (or until it expires), the calculator works out how much you’d use in that time. Anything left over is counted as wasted, along with what it cost you.',
  },
  {
    question: 'Can I compare different units?',
    answer: 'Yes, as long as they measure the same thing: grams with kilograms, millilitres with litres, ounces with pounds, or pieces with pieces.',
  },
];

const ex = calculateBulk({ regular: { price: 120, quantity: 500, unit: 'g' }, bulk: { price: 400, quantity: 2, unit: 'kg' } });
if ('error' in ex) throw new Error('example');
const exampleLink = `#${encodeStateForBuild({ rp: '120', rq: '500', ru: 'g', bp: '400', bq: '2', bu: 'kg', ua: '200', uu: 'g', up: 'week', life: '6', lp: 'week' })}`;
---

<ToolLayout slug="bulk-buying-calculator" intro="Compare a regular pack with a bulk pack, and check you’ll use it before it goes off." faq={faq}>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start lg:gap-10">
    <div data-tool class="grid grid-cols-1 gap-4">
      <ExampleNote />
      <div class="grid gap-4 sm:grid-cols-2">
        <fieldset class="rounded-card border border-line p-4 sm:p-5">
          <legend class="px-1 text-[15px] font-semibold">Regular pack</legend>
          <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_5.5rem] gap-2">
            <Field label="Price" k="rp" prefix="currency" value="120" />
            <Field label="Quantity" k="rq" value="500" />
            <UnitSelect k="ru" value="g" />
          </div>
        </fieldset>
        <fieldset class="rounded-card border border-line p-4 sm:p-5">
          <legend class="px-1 text-[15px] font-semibold">Bulk pack</legend>
          <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_5.5rem] gap-2">
            <Field label="Price" k="bp" prefix="currency" value="400" />
            <Field label="Quantity" k="bq" value="2" />
            <UnitSelect k="bu" value="kg" />
          </div>
        </fieldset>
      </div>
      <fieldset class="rounded-card border border-line p-4 sm:p-5">
        <legend class="px-1 text-[15px] font-semibold">How fast do you use it? <span class="font-normal text-muted">(optional)</span></legend>
        <p class="mb-3 text-[14px] text-muted">Add this to check you’ll finish the bulk pack before it expires.</p>
        <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_minmax(0,1fr)] gap-2">
          <Field label="I use about" k="ua" placeholder="e.g. 200" />
          <UnitSelect k="uu" value="g" label="Unit" />
          <SelectField label="How often" k="up" options={periods} value="week" />
        </div>
        <div class="mt-3 grid grid-cols-2 gap-2">
          <Field label="It lasts / expires in" k="life" placeholder="e.g. 6" />
          <SelectField label="Period" k="lp" options={lifePeriods} value="month" />
        </div>
      </fieldset>
    </div>
    <ResultPanel empty="Enter both packs to see which is better value." />
  </div>

  <Fragment slot="content">
    <h2>When is buying in bulk worth it?</h2>
    <p>
      A bulk pack is worth it when its price per unit is lower <strong>and</strong> you use enough of it before it goes off.
      The calculator compares the price per gram, millilitre or piece, then checks how much you’d actually use.
    </p>
    <h2>Example</h2>
    <p>
      500 g for ₹120 is ₹0.24 a gram. 2 kg for ₹400 is ₹0.20 a gram, so the bulk pack saves {(ex.savingFraction * 100).toFixed(1)}%
      per gram, or ₹{ex.bulkSaving} on 2 kg. But you’d need to use at least {((ex.breakEvenBase ?? 0) / 1000).toFixed(2)} kg of it
      for it to pay off. If you only get through 1.2 kg before it expires, the regular pack is cheaper for you.
      <a href={exampleLink}>Open this example</a>.
    </p>
  </Fragment>
</ToolLayout>

<script>
  import '../../scripts/tools/bulk';
</script>
