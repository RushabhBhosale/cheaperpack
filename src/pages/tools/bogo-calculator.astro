---
import ToolLayout from '../../components/layout/ToolLayout.astro';
import ResultPanel from '../../components/shared/ResultPanel.astro';
import ExampleNote from '../../components/shared/ExampleNote.astro';
import Field from '../../components/shared/Field.astro';
import { calculateBogo, equivalentDiscount } from '../../lib/calculations/bogo';
import { encodeStateForBuild } from '../../lib/ui/share-build';

const presets = [
  { label: 'Buy 1 get 1', buy: '1', get: '1' },
  { label: 'Buy 2 get 1', buy: '2', get: '1' },
  { label: 'Buy 3 get 2', buy: '3', get: '2' },
];

const faq = [
  {
    question: 'Is buy 1 get 1 free the same as 50% off?',
    answer:
      'Per item, yes: two items for the price of one is half price each. The difference is that you must buy two. If you only need one, a 50% discount is better because you pay half and get what you need.',
  },
  {
    question: 'What does “buy 2 get 1 free” really save?',
    answer: 'Three items for the price of two, so each item costs two thirds of the price: a saving of 33.3%.',
  },
  {
    question: 'What if the free item is the cheapest one?',
    answer:
      'Many shops give the cheapest item free when prices differ. This calculator assumes all items cost the same; if they don’t, enter the price of the item that would be free to be safe.',
  },
  {
    question: 'What happens with leftover items?',
    answer:
      'If the number you want doesn’t fill complete offer sets, the extra items are paid at full price. The result tells you when adding an item or two would get you more free.',
  },
];

const b2g1 = calculateBogo({ price: 300, buy: 2, get: 1, getDiscountPct: 100, comparePct: 25 });
const exampleLink = `#${encodeStateForBuild({ price: '300', buy: '2', get: '1', disc: '100', wanted: '', limit: '', compare: '25' })}`;
---

<ToolLayout slug="bogo-calculator" intro="Find out what a buy X get Y offer really costs per item, and whether a plain discount is better." faq={faq}>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start lg:gap-10">
    <div data-tool class="grid grid-cols-1 gap-4">
      <ExampleNote />
      <div class="flex flex-wrap gap-2" aria-label="Common offers">
        {presets.map((p) => <button type="button" class="btn btn-secondary !min-h-10 !px-4 !text-[14px]" data-preset-buy={p.buy} data-preset-get={p.get}>{p.label}</button>)}
      </div>
      <div class="grid grid-cols-2 gap-3 rounded-card border border-line p-4 sm:grid-cols-4 sm:p-5">
        <Field label="Price per item" k="price" prefix="currency" value="300" class="col-span-2 sm:col-span-1" />
        <Field label="Buy" k="buy" value="2" />
        <Field label="Get" k="get" value="1" />
        <Field label="Discount on those" k="disc" value="100" suffix="%" hint="100% = free" class="col-span-2 sm:col-span-1" />
      </div>
      <div class="grid grid-cols-2 gap-3 rounded-card border border-line p-4 sm:grid-cols-3 sm:p-5">
        <Field label="Items you want" k="wanted" optional placeholder="e.g. 4" />
        <Field label="Offer limit per order" k="limit" optional placeholder="e.g. 2" hint="Times the offer can be used" />
        <Field label="Compare with a discount of" k="compare" optional suffix="%" placeholder="e.g. 25" class="col-span-2 sm:col-span-1" />
      </div>
    </div>
    <ResultPanel empty="Enter the price and the offer to see the real cost per item." />
  </div>

  <Fragment slot="content">
    <h2>How buy X get Y offers work out</h2>
    <p>
      You pay for X items and get X + Y. The effective price per item is what you pay divided by everything you take home, and the
      saving is how much less that is than the normal price. Some common offers as plain discounts:
    </p>
    <ul>
      <li>Buy 1 get 1 free: {(equivalentDiscount(1, 1) * 100).toFixed(0)}% off each item</li>
      <li>Buy 2 get 1 free: {(equivalentDiscount(2, 1) * 100).toFixed(1)}% off each item</li>
      <li>Buy 3 get 2 free: {(equivalentDiscount(3, 2) * 100).toFixed(0)}% off each item</li>
      <li>Buy 1 get 1 at 50% off: {(equivalentDiscount(1, 1, 50) * 100).toFixed(0)}% off each item</li>
    </ul>
    <h2>Example</h2>
    <p>
      A ₹300 shirt on buy 2 get 1 free: you pay ₹{b2g1.set.paid} for 3, which is ₹{b2g1.set.perItem.toFixed(0)} each. Another shop offers 25% off,
      which is ₹{b2g1.compare!.perItem} each, so the buy 2 get 1 offer is cheaper per shirt, but only if you want three. <a href={exampleLink}>Open this example</a>.
    </p>
  </Fragment>
</ToolLayout>

<script>
  import '../../scripts/tools/bogo';
</script>
