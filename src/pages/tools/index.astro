---
import Base from '../../layouts/Base.astro';
import ToolGrid from '../../components/shared/ToolGrid.astro';
import { TOOLS, toolPath } from '../../data/tools';

const title = 'All money-saving tools | CheaperPack';
const description =
  'Every CheaperPack tool in one place: compare prices and packs, check deals and BOGO offers, work out EMI, subscriptions and running costs, and plan your shopping.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cheaperpack.com/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://cheaperpack.com/tools/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `https://cheaperpack.com${toolPath(t.slug)}` })),
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="page pt-5 sm:pt-7">
    <nav aria-label="Breadcrumb" class="text-[13px] text-muted">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-ink">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink-2">Tools</li>
      </ol>
    </nav>
    <h1 class="mt-3 text-[30px] font-bold tracking-tight sm:text-[36px]">All tools</h1>
    <p class="mt-1.5 max-w-2xl text-[17px] text-muted">Free, private and quick. Pick one and get an answer in seconds.</p>
    <div class="mt-8">
      <ToolGrid />
    </div>
  </div>
</Base>
