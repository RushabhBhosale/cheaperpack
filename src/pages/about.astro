---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/shared/Breadcrumbs.astro';
import { DEVICES } from '../data/devices';
import { GUIDES } from '../data/guides';
import { breadcrumbLd } from '../lib/seo';

const title = 'About CheaperPack and how we check our facts';
const description = 'How CheaperPack sources device specifications and repair guidance, what we leave out, how we make money (we don’t sell data) and how to report a mistake.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'About', href: '/about/' }];
const jsonLd = [breadcrumbLd(crumbs), { '@context': 'https://schema.org', '@type': 'AboutPage', name: title, url: 'https://cheaperpack.com/about/' }];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="page ownership-intro">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6">About CheaperPack.</h1>
    <p class="ownership-lede">CheaperPack helps people keep phones and other tech useful for longer: fix what can be fixed, buy the right accessory and choose used devices carefully.</p>
  </section>
  <div class="page device-copy about-copy">
    <h2>How we check our facts</h2>
    <p>The {DEVICES.length} device pages use specifications published by the manufacturer. Each page links the exact technical-specification page it relies on, and our data file ties every record to that URL.</p>
    <p>The {GUIDES.length} guides summarise manufacturer support articles. Each names its sources, lists a review date and says what the guide cannot tell you. We do not copy the articles; we condense them and link back so you can read the full text.</p>
    <h2>What we leave out</h2>
    <ul>
      <li>Prices, which change daily and vary by country.</li>
      <li>Repair-difficulty scores and “best phone” rankings we cannot back with a source.</li>
      <li>Compatibility claims for cases, screen protectors and internal parts without verified fit data.</li>
    </ul>
    <h2>Privacy and cost</h2>
    <p>The site is free, has no accounts and no paid API. Calculators run in your browser and what you type is not sent to a server. The only third-party script is Google Analytics. See the <a href="/privacy/">privacy page</a>.</p>
    <h2>Found a mistake?</h2>
    <p>Manufacturers update their documentation, so the linked source always wins. If a page here disagrees with its source, trust the source. We revise pages when the source changes and update the review date when we do.</p>
  </div>
</Base>
