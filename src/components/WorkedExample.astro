---
import { compareProducts } from '../lib/calculations/compare';
import { explainSteps, formatMoney, formatQuantity } from '../lib/formatting/format';

// Made-up numbers, computed with the same code as the calculator.
const result = compareProducts(
  [
    { name: 'Pack A', price: '3.49', quantity: '750', unit: 'g' },
    { name: 'Pack B', price: '4.49', quantity: '2', unit: 'lb' },
  ],
  { perUnitId: 'kg' },
);
if (result.status !== 'ok') throw new Error('Worked example must compare cleanly');
const best = result.best[0]!;
const other = result.runnerUp!;
// The text below says the bigger pack loses; keep that true if the numbers change.
if (other.baseQuantity <= best.baseQuantity) throw new Error('Worked example: the bigger pack should be the worse deal');
const cur = 'USD';
const locale = 'en-US';
---

<div class="mt-5 rounded-card border border-line p-5">
  <p class="!mt-0 font-semibold text-ink">Worked example <span class="font-normal text-muted">(made-up prices, in US dollars)</span></p>
  <ul class="!list-none !pl-0">
    {
      result.products.map((p) => (
        <li>
          <strong>{p.label}:</strong> {formatMoney(p.price, cur, locale)} for {formatQuantity(p, locale)}
          <div class="formula">
            {explainSteps(p, result.perUnit, cur, locale).map((s) => (
              <div>{s}</div>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
  <p>
    <strong>{best.label}</strong> is the better value, even though {other.label} is the bigger pack: {other.label} costs{' '}
    {formatMoney(other.diffPerUnit, cur, locale, true)} more per kg. Buying {formatQuantity(other, locale)} at{' '}
    {best.label}’s unit price would cost {formatMoney(other.price - other.extraForThisAmount, cur, locale)} instead of{' '}
    {formatMoney(other.price, cur, locale)}.
  </p>
</div>

