---
/**
 * Page frame for every tool: breadcrumbs, heading, the tool itself first,
 * then short explanations, FAQ and related tools.
 */
import Base from '../../layouts/Base.astro';
import Faq, { type FaqEntry } from '../shared/Faq.astro';
import RelatedTools from '../shared/RelatedTools.astro';
import { getTool, toolPath } from '../../data/tools';

interface Props {
  slug: string;
  faq: FaqEntry[];
  /** Shorter line under the H1 than the meta description. */
  intro: string;
  heading?: string;
}

const { slug, faq, intro, heading } = Astro.props;
const tool = getTool(slug);
const url = new URL(toolPath(slug), Astro.site ?? 'https://cheaperpack.com').href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url,
    description: tool.description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cheaperpack.com/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://cheaperpack.com/tools/' },
      { '@type': 'ListItem', position: 3, name: tool.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
];
---

<Base title={tool.title} description={tool.description} jsonLd={jsonLd}>
  <div class="page pt-5 pb-2 sm:pt-7">
    <nav aria-label="Breadcrumb" class="text-[13px] text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-ink">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tools/" class="hover:text-ink">Tools</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink-2">{tool.name}</li>
      </ol>
    </nav>
    <h1 class="mt-3 text-[28px] leading-tight font-bold tracking-tight sm:text-[34px]">{heading ?? tool.name}</h1>
    <p class="mt-1.5 max-w-2xl text-[16px] text-muted sm:text-[17px]">{intro}</p>
  </div>

  <div class="page mt-5">
    <slot />
  </div>

  <div class="page mt-16">
    <div class="prose">
      <slot name="content" />
    </div>
    <div class="max-w-[44rem]">
      <Faq items={faq} />
    </div>
    <RelatedTools slugs={tool.related} />
  </div>
</Base>
