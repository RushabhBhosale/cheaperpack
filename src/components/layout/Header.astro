---
import Logo from '../Logo.astro';

const path = Astro.url.pathname;
const onTools = path.startsWith('/tools/');
---

<header class="site-header">
  <div class="page site-header-inner">
    <a href="/" class="site-wordmark" aria-label="CheaperPack home">
      <Logo />
      <span>CheaperPack</span>
    </a>
    <nav aria-label="Main" class="site-nav">
      <a href="/devices/" aria-current={path.startsWith('/devices/') ? 'page' : undefined}>Devices</a>
      <a href="/guides/" aria-current={path.startsWith('/guides/') ? 'page' : undefined}>Guides</a>
      <a href="/tools/" aria-current={onTools ? 'page' : undefined}>Tools</a>
      <a href="/compatibility/" class="site-nav-action" aria-current={path === '/compatibility/' ? 'page' : undefined}>Check a cable</a>
    </nav>
  </div>
</header>
