---
import ToolCard from './ToolCard.astro';
import { CATEGORIES, TOOLS } from '../../data/tools';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const Heading = Astro.props.headingLevel ?? 'h2';
---

<div class="grid gap-10">
  {
    CATEGORIES.map((cat) => (
      <section aria-labelledby={`cat-${cat.name}`}>
        <div class="flex items-baseline gap-3">
          <Heading id={`cat-${cat.name}`} class="text-[20px] font-semibold tracking-tight">
            {cat.name}
          </Heading>
          <span class="text-[14px] text-muted">{cat.blurb}</span>
        </div>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {TOOLS.filter((t) => t.category === cat.name).map((t) => (
            <li>
              <ToolCard tool={t} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
