---
/** A titled grid of internal links, used for related guides, devices and tools. */
interface Props {
  heading: string;
  links: { label: string; href: string; hint?: string }[];
  id?: string;
}
const { heading, links, id = heading.toLowerCase().replace(/[^a-z0-9]+/g, '-') } = Astro.props;
---

{links.length > 0 && (
  <section class="link-section" aria-labelledby={id}>
    <h2 id={id}>{heading}</h2>
    <ul class="link-grid">
      {links.map((l) => <li><a href={l.href}><strong>{l.label}</strong>{l.hint && <small>{l.hint}</small>}</a></li>)}
    </ul>
  </section>
)}
