---
/** Currency picker shared by every tool. The script in lib/ui/currency.ts keeps them in sync. */
import { TOOL_CURRENCIES } from '../../lib/formatting/currency';
interface Props {
  class?: string;
}
---

<label class:list={['inline-flex items-center gap-2 text-[14px] text-muted', Astro.props.class]}>
  <span>Currency</span>
  <span class="ui-box !min-h-10 !rounded-full">
    <select data-currency class="!py-1.5 !pl-3 !text-[15px]" aria-describedby="currency-note">
      {TOOL_CURRENCIES.map((c) => <option value={c}>{c}</option>)}
    </select>
  </span>
  <span id="currency-note" class="sr-only">Changes the currency symbol only. Amounts are not converted.</span>
</label>
