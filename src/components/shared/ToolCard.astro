---
import Icon from './Icon.astro';
import { toolPath, type Tool } from '../../data/tools';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<a
  href={toolPath(tool.slug)}
  class="group flex h-full items-start gap-4 rounded-card border border-line bg-white p-4 transition hover:border-line-strong hover:bg-subtle sm:p-5"
>
  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-subtle text-ink ring-1 ring-line transition group-hover:bg-white">
    <Icon name={tool.icon} />
  </span>
  <span class="min-w-0">
    <span class="block text-[16px] font-semibold text-ink">{tool.name}</span>
    <span class="mt-0.5 block text-[14px] leading-snug text-muted">{tool.short}</span>
  </span>
</a>
