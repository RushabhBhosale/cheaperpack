---
import { TOOL_UNIT_GROUPS, TOOL_UNIT_LABELS, type ToolUnit } from '../../lib/storage/tool-state';

interface Props {
  k: string;
  value?: ToolUnit;
  label?: string;
  hideLabel?: boolean;
  /** Only the everyday units. */
  simple?: boolean;
  class?: string;
}
const { k, value = 'g', label = 'Unit', hideLabel, simple, class: className } = Astro.props;
const groups = simple ? TOOL_UNIT_GROUPS.slice(0, 1) : TOOL_UNIT_GROUPS;
---

<div data-field class={className}>
  <label class="block">
    <span class:list={['ui-label', { 'sr-only': hideLabel }]} data-label>{label}</span>
    <span class="ui-box">
      <select data-k={k}>
        {
          groups.map((g) =>
            simple ? (
              g.units.map((u) => (
                <option value={u} selected={u === value}>
                  {TOOL_UNIT_LABELS[u]}
                </option>
              ))
            ) : (
              <optgroup label={g.label}>
                {g.units.map((u) => (
                  <option value={u} selected={u === value}>
                    {TOOL_UNIT_LABELS[u]}
                  </option>
                ))}
              </optgroup>
            ),
          )
        }
      </select>
    </span>
  </label>
</div>
