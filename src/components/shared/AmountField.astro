---
/** A discount-style amount that can be a percentage or a flat amount. */
interface Props {
  label: string;
  k: string;
  kindK: string;
  kind?: 'pct' | 'fixed';
  value?: string;
  optional?: boolean;
  placeholder?: string;
  class?: string;
}
const { label, k, kindK, kind = 'pct', value, optional, placeholder = '0', class: className } = Astro.props;
---

<div data-field class={className}>
  <label class="block">
    <span class="ui-label" data-label>{label}{optional && <span class="font-normal text-muted"> (optional)</span>}</span>
    <span class="ui-box">
      <input data-k={k} type="text" inputmode="decimal" autocomplete="off" value={value} placeholder={placeholder} maxlength="20" />
      <span class="h-6 w-px shrink-0 bg-line" aria-hidden="true"></span>
      <select data-k={kindK} aria-label={`${label}: percent or amount`} class="!w-auto !text-[15px]">
        <option value="pct" selected={kind === 'pct'}>%</option>
        <option value="fixed" selected={kind === 'fixed'} data-cur>₹</option>
      </select>
    </span>
  </label>
  <p class="ui-error" data-error hidden></p>
</div>
