---
/**
 * Labelled input. Numbers use a text input with a decimal keyboard so
 * "3,49" and "3.49" both work on every phone. The label wraps the input, so
 * it also works inside repeated rows without unique ids.
 */
interface Props {
  label: string;
  k: string;
  value?: string;
  /** "currency" shows the selected currency symbol. */
  prefix?: string;
  suffix?: string;
  placeholder?: string;
  hint?: string;
  optional?: boolean;
  type?: 'number' | 'text' | 'date';
  class?: string;
  maxlength?: number;
  /** Visually hide the label (it's still read out). */
  hideLabel?: boolean;
  /** Use the row's name ("Deal A") as placeholder. */
  rowPlaceholder?: boolean;
}
const { label, k, value, prefix, suffix, placeholder, hint, optional, type = 'number', class: className, maxlength, hideLabel, rowPlaceholder } = Astro.props;
---

<div data-field class={className}>
  <label class="block">
    <span class:list={['ui-label', { 'sr-only': hideLabel }]} data-label>
      {label}{optional && <span class="font-normal text-muted"> (optional)</span>}
    </span>
    <span class="ui-box">
      {prefix === 'currency' ? <span class="ui-affix" data-cur aria-hidden="true">₹</span> : prefix ? <span class="ui-affix" aria-hidden="true">{prefix}</span> : null}
      <input
        data-k={k}
        type={type === 'date' ? 'date' : 'text'}
        inputmode={type === 'number' ? 'decimal' : undefined}
        autocomplete="off"
        enterkeyhint="next"
        value={value}
        placeholder={placeholder}
        data-row-placeholder={rowPlaceholder ? '' : undefined}
        maxlength={maxlength ?? (type === 'text' ? 60 : 20)}
      />
      {suffix && <span class="ui-suffix" aria-hidden="true">{suffix}</span>}
    </span>
  </label>
  {hint && <p class="ui-hint">{hint}</p>}
  <p class="ui-error" data-error hidden></p>
</div>
