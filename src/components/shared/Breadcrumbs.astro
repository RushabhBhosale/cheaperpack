---
import type { Crumb } from '../../lib/seo';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<nav class="ownership-breadcrumb" aria-label="Breadcrumb">
  {crumbs.map((c, i) => (i === last ? <span aria-current="page">{c.name}</span> : <><a href={c.href}>{c.name}</a><span aria-hidden="true">/</span></>))}
</nav>
