---
/**
 * Result area shared by every calculator: live result, Share/Reset and
 * the visitor's recent calculations.
 */
import CurrencySelect from './CurrencySelect.astro';

interface Props {
  empty: string;
  /** Hide Share (for private data). */
  noShare?: boolean;
  /** Hide the recent calculations list. */
  noHistory?: boolean;
  currency?: boolean;
  title?: string;
}
const { empty, noShare, noHistory, currency = true, title = 'Result' } = Astro.props;
---

<div class="lg:sticky lg:top-20">
  <section class="result-panel" aria-labelledby="result-title">
    <div class="flex items-center justify-between gap-3">
      <h2 id="result-title" class="eyebrow">{title}</h2>
      {currency && <CurrencySelect />}
    </div>
    <div data-result class="mt-3">
      <p class="text-[15px] leading-relaxed text-muted">{empty}</p>
    </div>
    <div class="mt-5 flex gap-2 border-t border-line pt-4" data-actions hidden>
      {
        !noShare && (
          <button type="button" class="btn btn-secondary flex-1" data-share>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Share
          </button>
        )
      }
      <button type="button" class="btn btn-ghost" data-reset>Reset</button>
    </div>
    <slot />
  </section>

  {
    !noHistory && (
      <section class="mt-4" data-history hidden aria-labelledby="history-title">
        <div class="flex items-center justify-between px-1">
          <h2 id="history-title" class="eyebrow">Recent</h2>
          <button type="button" class="btn btn-ghost !min-h-9 !px-2 !text-[13px]" data-history-clear>
            Clear history
          </button>
        </div>
        <ul class="mt-1 divide-y divide-line rounded-card border border-line bg-white" data-history-list />
      </section>
    )
  }
  <p class="sr-only" role="status" aria-live="polite" data-live></p>
</div>
