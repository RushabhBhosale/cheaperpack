---
import type { Device } from '../../data/devices';
import { devicePath } from '../../data/devices';
interface Props {
  device: Device;
}
const { device } = Astro.props;
const search = `${device.name} ${device.chip} ${device.screen} ${device.port} ${device.year} ${device.series}`.toLowerCase();
---

<a class="device-card" href={devicePath(device.slug)} data-device-card data-search={search} data-port={device.port}>
  <span class="device-card-top"><strong>{device.name}</strong><span class={`port-pill port-${device.port === 'USB-C' ? 'usbc' : 'lightning'}`}>{device.port}</span></span>
  <small>{device.year} · {device.screen}</small>
  <small>{device.chip} · {device.wirelessCharging}</small>
</a>
