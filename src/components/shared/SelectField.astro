---
interface Props {
  label: string;
  k: string;
  options: { value: string; label: string }[];
  value?: string;
  class?: string;
  hideLabel?: boolean;
}
const { label, k, options, value, class: className, hideLabel } = Astro.props;
---

<div data-field class={className}>
  <label class="block">
    <span class:list={['ui-label', { 'sr-only': hideLabel }]} data-label>{label}</span>
    <span class="ui-box">
      <select data-k={k}>
        {
          options.map((o) => (
            <option value={o.value} selected={o.value === value}>
              {o.label}
            </option>
          ))
        }
      </select>
    </span>
  </label>
  <p class="ui-error" data-error hidden></p>
</div>
