---
import Field from '../shared/Field.astro';
import RowHeader from '../shared/RowHeader.astro';
interface Props {
  values?: Record<string, string>;
}
const v = Astro.props.values ?? {};
---

<li data-row class="ui-enter rounded-card border border-line bg-white p-4 sm:p-5">
  <RowHeader placeholder="Option A" value={v.name} />
  <div class="mt-3 grid grid-cols-2 gap-3">
    <Field label="Price" k="price" prefix="currency" value={v.price} placeholder="0" />
    <Field label="Times you’ll use it" k="uses" value={v.uses} placeholder="e.g. 100" />
  </div>
  <details class="group mt-3" open={!!(v.upkeep || v.resale)}>
    <summary class="inline-flex min-h-10 items-center gap-1 rounded-lg px-1 text-[14px] font-semibold text-accent">
      Upkeep and resale <span class="transition group-open:rotate-180" aria-hidden="true">⌄</span>
    </summary>
    <div class="mt-2 grid grid-cols-2 gap-3">
      <Field label="Upkeep costs" k="upkeep" prefix="currency" value={v.upkeep} optional hint="Repairs, servicing, refills" />
      <Field label="Resale value" k="resale" prefix="currency" value={v.resale} optional hint="What you could sell it for later" />
    </div>
  </details>
</li>
