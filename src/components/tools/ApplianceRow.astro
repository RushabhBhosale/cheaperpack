---
import Field from '../shared/Field.astro';
import RowHeader from '../shared/RowHeader.astro';
interface Props {
  values?: Record<string, string>;
}
const v = Astro.props.values ?? {};
---

<li data-row class="ui-enter rounded-card border border-line bg-white p-4 sm:p-5">
  <RowHeader placeholder="Appliance A" value={v.name} />
  <div class="mt-3 grid grid-cols-3 gap-2 sm:gap-3">
    <Field label="Power" k="watts" suffix="W" value={v.watts} placeholder="0" />
    <Field label="Hours a day" k="hours" value={v.hours} placeholder="0" />
    <Field label="Days a month" k="days" value={v.days ?? '30'} />
  </div>
  <details class="group mt-3" open={!!(v.standby || (v.qty && v.qty !== '1'))}>
    <summary class="inline-flex min-h-10 items-center gap-1 rounded-lg px-1 text-[14px] font-semibold text-accent">
      Standby and quantity <span class="transition group-open:rotate-180" aria-hidden="true">⌄</span>
    </summary>
    <div class="mt-2 grid grid-cols-2 gap-3">
      <Field label="Standby power" k="standby" suffix="W" value={v.standby} optional hint="Power used when plugged in but off" />
      <Field label="How many" k="qty" value={v.qty ?? '1'} />
    </div>
  </details>
</li>
