---
import Field from '../shared/Field.astro';
import AmountField from '../shared/AmountField.astro';

interface Props {
  values?: Record<string, string>;
}
const v = Astro.props.values ?? {};
---

<li data-row class="ui-enter rounded-card border border-line bg-white p-4 sm:p-5">
  <div class="flex items-center gap-3">
    <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ink text-[13px] font-semibold text-white" data-row-letter aria-hidden="true">A</span>
    <label class="min-w-0 flex-1">
      <span class="sr-only">Name (optional)</span>
      <input
        data-k="name"
        data-row-placeholder
        type="text"
        maxlength="40"
        autocomplete="off"
        value={v.name}
        placeholder="Deal A"
        class="w-full rounded-lg bg-transparent px-1 py-1.5 text-[17px] font-semibold outline-none placeholder:text-ink"
      />
    </label>
    <button type="button" data-remove hidden class="icon-btn" aria-label="Remove deal">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    </button>
  </div>
  <div class="mt-3 grid grid-cols-2 gap-3">
    <Field label="Price" k="price" prefix="currency" value={v.price} placeholder="0" />
    <Field label="Items you pay for" k="qty" value={v.qty ?? '1'} />
    <AmountField label="Discount" k="d1" kindK="d1k" kind={(v.d1k as 'pct' | 'fixed') ?? 'pct'} value={v.d1} optional />
    <Field label="Delivery" k="delivery" prefix="currency" value={v.delivery} placeholder="0" optional />
  </div>
  <details class="group mt-3" open={!!(v.d2 || v.cb || v.buy || v.d1cap)}>
    <summary class="inline-flex min-h-10 items-center gap-1 rounded-lg px-1 text-[14px] font-semibold text-accent">
      More offers: coupon, cashback, buy X get Y{' '}
      <span class="transition group-open:rotate-180" aria-hidden="true">⌄</span>
    </summary>
    <div class="mt-2 grid grid-cols-2 gap-3">
      <Field label="Discount capped at" k="d1cap" prefix="currency" value={v.d1cap} optional hint="For offers like “20% off, up to 100”." />
      <AmountField label="Coupon" k="d2" kindK="d2k" kind={(v.d2k as 'pct' | 'fixed') ?? 'fixed'} value={v.d2} optional />
      <AmountField label="Extra discount" k="d3" kindK="d3k" kind={(v.d3k as 'pct' | 'fixed') ?? 'pct'} value={v.d3} optional />
      <Field label="Coupon capped at" k="d2cap" prefix="currency" value={v.d2cap} optional />
      <AmountField label="Cashback" k="cb" kindK="cbk" kind={(v.cbk as 'pct' | 'fixed') ?? 'pct'} value={v.cb} optional />
      <Field label="Cashback capped at" k="cbcap" prefix="currency" value={v.cbcap} optional />
      <Field label="Buy" k="buy" value={v.buy} optional placeholder="e.g. 2" />
      <Field label="Get free" k="get" value={v.get} optional placeholder="e.g. 1" />
    </div>
  </details>
</li>
