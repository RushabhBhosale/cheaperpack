---
import { TOOL_UNIT_GROUPS, TOOL_UNIT_LABELS } from '../../lib/storage/tool-state';

interface Props {
  letter: string;
  currencySymbol: string;
}
const { letter, currencySymbol } = Astro.props;
const label = `Product ${letter}`;
---

<li class="ui-enter rounded-card border border-line bg-white p-4" data-row>
  <div class="flex items-center gap-3">
    <span
      class="grid size-7 shrink-0 place-items-center rounded-full bg-ink text-[13px] font-semibold text-white"
      data-letter
      aria-hidden="true">{letter}</span
    >
    <label class="min-w-0 flex-1">
      <span class="sr-only" data-name-label>{label} name (optional)</span>
      <input
        data-f="name"
        type="text"
        maxlength="60"
        autocomplete="off"
        enterkeyhint="next"
        placeholder={label}
        class="w-full rounded-lg border-0 bg-transparent px-1 py-1.5 text-[17px] font-semibold outline-none placeholder:font-semibold placeholder:text-ink"
      />
    </label>
    <button
      type="button"
      data-remove
      hidden
      aria-label={`Remove ${label}`}
      class="icon-btn"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
        ><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg
      >
    </button>
  </div>
  <div class="mt-3 grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)_5.25rem] gap-2">
    <label class="block">
      <span class="ui-label">Price</span>
      <span class="ui-box">
        <span class="ui-affix" data-cur aria-hidden="true">{currencySymbol}</span>
        <input data-f="price" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="next" placeholder="0" />
      </span>
    </label>
    <label class="block">
      <span class="ui-label">Quantity</span>
      <span class="ui-box">
        <input data-f="quantity" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="next" placeholder="0" />
      </span>
    </label>
    <label class="block">
      <span class="ui-label">Unit</span>
      <span class="ui-box">
        <select data-f="unit">
          {TOOL_UNIT_GROUPS.map((g) => (
            <optgroup label={g.label}>{g.units.map((u) => <option value={u}>{TOOL_UNIT_LABELS[u]}</option>)}</optgroup>
          ))}
        </select>
      </span>
    </label>
  </div>
  <p class="mt-2 text-[13px] font-medium text-bad" data-err hidden></p>
</li>
