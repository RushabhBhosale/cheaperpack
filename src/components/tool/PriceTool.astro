---
import ToolRow from './ToolRow.astro';
import CurrencySelect from '../shared/CurrencySelect.astro';
import { TOOL_UNIT_GROUPS, TOOL_UNIT_LABELS } from '../../lib/storage/tool-state';

// Server-rendered default; the script swaps in the visitor's currency.
const symbol = '₹';
---

<div data-tool>
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] lg:items-start lg:gap-8">
    <!-- Inputs -->
    <section aria-labelledby="pt-inputs" class="min-w-0">
      <h2 id="pt-inputs" class="sr-only">Products</h2>

      <div class="flex items-end gap-2">
        <label class="min-w-0 flex-1">
          <span class="ui-label">Type or paste prices</span>
          <span class="ui-box !items-start">
            <textarea
              data-quick
              rows="1"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="done"
              aria-describedby="pt-quick-hint"
              placeholder="2kg for 210, 1.5kg for 189"
              class="max-h-40 resize-none !text-base leading-6"></textarea>
          </span>
        </label>
        <button
          type="button"
          data-scan
          class="btn btn-secondary !min-h-12 shrink-0 !rounded-[12px]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M7 12h10"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
          <span>Scan<span class="sr-only"> a price tag</span></span>
        </button>
      </div>
      <p id="pt-quick-hint" class="mt-1.5 min-h-5 text-[13px] text-muted" data-quick-hint>
        Any order works: “Rs 210 – 2 kg”, “500ml 28 / 1L 54”, “6 x 330ml for 240”.
      </p>

      <ol class="mt-3 grid gap-3" data-rows aria-label="Products to compare">
        <ToolRow letter="A" currencySymbol={symbol} />
        <ToolRow letter="B" currencySymbol={symbol} />
      </ol>
      <template data-row-template><ToolRow letter="A" currencySymbol={symbol} /></template>

      <div class="mt-3 flex items-center justify-between gap-3">
        <button
          type="button"
          data-add
          class="btn btn-link"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
            ><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg
          >
          Add product
        </button>
        <div class="flex items-center gap-1">
          <CurrencySelect />
          <button type="button" data-reset class="btn btn-ghost">
            Reset
          </button>
        </div>
      </div>
      <noscript>
        <p class="mt-4 rounded-card bg-warn-soft p-4 text-[15px] text-warn">
          The comparison tool needs JavaScript. Divide each price by its quantity to compare by hand.
        </p>
      </noscript>
    </section>

    <!-- Result -->
    <section aria-labelledby="pt-result-title" class="min-w-0 lg:sticky lg:top-20" data-result-section>
      <div class="result-panel">
        <div class="flex items-center justify-between gap-3">
          <h2 id="pt-result-title" tabindex="-1" class="text-[13px] font-semibold tracking-[0.06em] text-muted uppercase outline-none" data-result-title>
            Result
          </h2>
          <button
            type="button"
            data-per
            hidden
            class="rounded-full bg-white px-3 py-1.5 text-[13px] font-semibold text-ink-2 ring-1 ring-line transition hover:ring-line-strong"></button>
        </div>
        <div data-result aria-live="off">
          <p class="mt-3 text-[15px] leading-relaxed text-muted">
            Add a price and quantity for two products. The better buy shows up here as you type.
          </p>
        </div>
        <div class="mt-5 flex gap-2 border-t border-line pt-4" data-actions hidden>
          <button
            type="button"
            data-share
            class="btn btn-secondary flex-1"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            Share
          </button>
        </div>
      </div>

      <div class="mt-4" data-recents-wrap hidden>
        <div class="flex items-center justify-between px-1">
          <h2 class="eyebrow">Recent</h2>
          <button type="button" data-recents-clear class="btn btn-ghost !min-h-9 !px-2 !text-[13px]">Clear history</button>
        </div>
        <ul class="mt-1 divide-y divide-line rounded-card border border-line bg-white" data-recents></ul>
      </div>
    </section>
  </div>

  <!-- Compact summary on phones while the result is scrolled out of view -->
  <button
    type="button"
    data-sticky
    data-show="false"
    aria-hidden="true"
    tabindex="-1"
    class="ui-sticky fixed inset-x-3 bottom-3 z-20 flex items-center gap-3 rounded-2xl bg-ink px-4 py-3 text-left text-white lg:hidden"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  >
    <span class="grid size-6 shrink-0 place-items-center rounded-full bg-white/15 text-[12px]">✓</span>
    <span class="min-w-0 flex-1 truncate text-[15px] font-medium" data-sticky-text></span>
    <span class="text-[13px] text-white/70">View</span>
  </button>

  <p class="sr-only" role="status" aria-live="polite" data-live></p>
  <div
    class="pointer-events-none fixed inset-x-0 bottom-20 z-30 flex justify-center px-4"
    aria-hidden="true">
    <span class="ui-fade rounded-full bg-ink px-4 py-2 text-[14px] font-medium text-white" data-toast hidden></span>
  </div>

  <!-- Scanner (logic loads only when opened) -->
  <dialog
    class="ui-sheet m-0 mt-auto w-full max-w-none rounded-t-[24px] bg-white p-0 text-ink sm:m-auto sm:max-w-lg sm:rounded-[24px]"
    aria-labelledby="pt-scan-title"
    data-scanner
  >
    <div class="max-h-[90dvh] overflow-y-auto p-5 sm:p-6" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom));">
      <div class="flex items-center justify-between gap-3">
        <h2 id="pt-scan-title" class="text-[19px] font-semibold">Scan a price tag</h2>
        <button
          type="button"
          data-scan-close
          aria-label="Close scanner"
          class="icon-btn bg-subtle"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"
            ><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
          >
        </button>
      </div>

      <div data-scan-pick>
        <p class="mt-2 text-[15px] leading-relaxed text-muted" data-scan-intro>
          Photograph the price label or pack. The photo is read on this device and never uploaded.
        </p>
        <div class="mt-4 grid grid-cols-2 gap-2">
          <label
            class="btn btn-primary !min-h-14 !rounded-[14px] cursor-pointer focus-within:outline-2 focus-within:outline-accent"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M4 8a2 2 0 0 1 2-2h1.5l1.2-1.8A1 1 0 0 1 9.5 4h5a1 1 0 0 1 .8.4L16.5 6H18a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8z"
                stroke="currentColor"
                stroke-width="1.8"></path><circle cx="12" cy="12.5" r="3.5" stroke="currentColor" stroke-width="1.8"></circle></svg
            >
            Take photo
            <input type="file" accept="image/*" capture="environment" class="sr-only" data-scan-camera />
          </label>
          <label
            class="btn btn-secondary !min-h-14 !rounded-[14px] cursor-pointer focus-within:outline-2 focus-within:outline-accent"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><rect x="3.5" y="4.5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.8"></rect><path
                d="M3.5 16l5-5 4 4 3-3 5 5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path></svg
            >
            Choose image
            <input type="file" accept="image/*" class="sr-only" data-scan-file />
          </label>
        </div>
      </div>

      <div class="mt-4" data-scan-status hidden>
        <div class="flex items-center gap-3">
          <img alt="" class="size-14 shrink-0 rounded-xl object-cover ring-1 ring-hairline" data-scan-thumb hidden />
          <div class="min-w-0 flex-1">
            <p class="text-[15px] font-medium" data-scan-step></p>
            <div
              class="mt-2 h-1.5 overflow-hidden rounded-full bg-field"
              role="progressbar"
              aria-label="Scanning progress"
              aria-valuemin="0"
              aria-valuemax="100"
              data-scan-progress
            >
              <div class="ui-bar h-full w-0 rounded-full bg-accent" data-scan-bar></div>
            </div>
          </div>
        </div>
      </div>

      <p class="mt-4 rounded-[14px] p-3.5 text-[14px] leading-relaxed" data-scan-message hidden></p>

      <form class="mt-4" data-scan-form hidden novalidate>
        <p class="text-[13px] font-semibold tracking-[0.06em] text-muted uppercase">Check and correct</p>
        <div class="mt-2 grid gap-2">
          <label class="block">
            <span class="ui-label">Name</span>
            <span class="ui-box"><input data-sf="name" type="text" maxlength="60" autocomplete="off" placeholder="Optional" /></span>
          </label>
          <div class="grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)_5.25rem] gap-2">
            <label class="block">
              <span class="ui-label">Price</span>
              <span class="ui-box"
                ><span class="ui-affix" data-cur aria-hidden="true">{symbol}</span><input
                  data-sf="price"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  
                /></span
              >
            </label>
            <label class="block">
              <span class="ui-label">Quantity</span>
              <span class="ui-box"><input data-sf="quantity" type="text" inputmode="decimal" autocomplete="off" /></span>
            </label>
            <label class="block">
              <span class="ui-label">Unit</span>
              <span class="ui-box">
                <select data-sf="unit">
                  {TOOL_UNIT_GROUPS.map((g) => (
            <optgroup label={g.label}>{g.units.map((u) => <option value={u}>{TOOL_UNIT_LABELS[u]}</option>)}</optgroup>
          ))}
                </select>
              </span>
            </label>
          </div>
          <div class="flex flex-wrap gap-1.5" data-scan-options></div>
          <details class="text-[13px] text-muted" data-scan-raw-wrap hidden>
            <summary class="cursor-pointer py-1">Text found in the photo</summary>
            <pre class="mt-1 max-h-40 overflow-auto rounded-xl bg-field p-3 font-sans text-[13px] whitespace-pre-wrap" data-scan-raw></pre>
          </details>
        </div>
        <div class="mt-4 grid grid-cols-[auto_1fr] gap-2">
          <button type="button" data-scan-again class="btn btn-secondary">
            Scan another
          </button>
          <button type="submit" class="btn btn-primary">
            Add to comparison
          </button>
        </div>
      </form>
    </div>
  </dialog>
</div>

<script>
  import '../../scripts/price-tool';
</script>
