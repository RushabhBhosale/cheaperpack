---
import '../styles/app.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Structured data objects, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://cheaperpack.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="google-site-verification" content="vkFi2ZvSlw_b3dfGo7kRPN11HxxcIBYU6XIfXn0N0Js" />

    <!-- Google tag (gtag.js); set-up lives in src/scripts/analytics.ts -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J8LMKCM7YX"></script>
    <script>
      import '../scripts/analytics';
    </script>
    <script>
      import '../scripts/reveal';
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CheaperPack" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CheaperPack: spend smarter, save more" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-white px-4 py-2 text-ink ring-1 ring-line focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a
    >
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
