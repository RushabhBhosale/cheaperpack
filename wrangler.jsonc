{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cheaperpack",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,

  // Static files (favicon, social image, search-console verification) are served straight from
  // /public without running the Worker. Everything else is rendered by the Worker from D1.
  "assets": { "directory": "./public", "html_handling": "none" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recalls",
      // Created with `npx wrangler d1 create recalls --location enam` (US East, close to the audience).
      "database_id": "7410e10b-e14b-44f8-be78-cead1c8c0948",
      "migrations_dir": "migrations"
    }
  ],

  // Pull new and updated recalls from CPSC twice a day.
  "triggers": { "crons": ["23 6,18 * * *"] },

  "vars": {
    "SITE_NAME": "Recall Radar",
    "SITE_URL": "https://cheaperpack.com",
    // Day the site goes live. Drives how many older recalls are allowed into the index (see src/seo.ts).
    "LAUNCH_DATE": "2026-10-24",
    // Shown on the Contact page. Leave empty to hide until you choose a public address.
    "CONTACT_EMAIL": "bhosalerushabh0@gmail.com",
    // Fill in after AdSense approves the site, e.g. "ca-pub-1234567890123456". Empty = no ads, no ad script.
    "ADSENSE_PUB_ID": "",
    // Optional ad unit id for the reserved in-content slots. Empty = Auto ads only.
    "ADSENSE_SLOT": "",
    "GA_ID": "",
    "GSC_VERIFICATION": "vkFi2ZvSlw_b3dfGo7kRPN11HxxcIBYU6XIfXn0N0Js",
    // Random string; enables IndexNow pings (Bing and others). Served at /<key>.txt
    "INDEXNOW_KEY": "b4d6f1a09c7e4d3f8a2b5c6d7e8f9012"
  },

  // The cheaperpack.com zone must be active on this Cloudflare account; deploying creates the DNS records.
  "routes": [
    { "pattern": "cheaperpack.com", "custom_domain": true },
    { "pattern": "www.cheaperpack.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
