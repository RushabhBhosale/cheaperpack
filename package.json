{
  "name": "recall-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-updating US consumer product recall tracker on Cloudflare Workers and D1, built from the CPSC recall feed.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply recalls --local",
    "backfill:local": "node --experimental-strip-types scripts/backfill.ts --local",
    "backfill:remote": "node --experimental-strip-types scripts/backfill.ts --remote",
    "images": "node scripts/make-images.mjs",
    "deploy": "npm run check && npm test && wrangler deploy --var CACHE_VERSION:$(date +%s)",
    "backfill:cars:local": "node --experimental-strip-types scripts/backfill-cars.ts --local",
    "backfill:cars:remote": "node --experimental-strip-types scripts/backfill-cars.ts --remote",
    "backfill:food:local": "node --experimental-strip-types scripts/backfill-food.ts --local",
    "backfill:food:remote": "node --experimental-strip-types scripts/backfill-food.ts --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.20.5",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.151.1"
  }
}
